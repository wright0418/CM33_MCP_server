              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Tx FIFO non-empty</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Tx FIFO empty</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>

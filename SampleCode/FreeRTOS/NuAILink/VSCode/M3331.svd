            </field>
            <field>
              <name>DBGPSEL</name>
              <description>PSEL Debug Vaule. (Write Protect)</description>
              <bitOffset>24</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>SCHTEST</name>
              <description>HXT Schmitt Trigger Test Mode Enable (Write Protect)\n</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>

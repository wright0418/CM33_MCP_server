            <field>
              <name>ACMPIF0</name>
              <description>ACMP Interrupt Flag 0\nThis bit is set by hardware when the edge condition defined by INTPOL (ACMP_CTL0[31:30]) is detected on ACMP0 output. This will generate an interrupt if ACMPIE (ACMP_CTL0[1]) is set to 1.\nNote: Write 1 to clear this bit to 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACMPIF1</name>
              <description>ACMP Interrupt Flag 1\nThis bit is set by hardware when the edge condition defined by INTPOL (ACMP_CTL1[31:30]) is detected on ACMP1 output. This will cause an interrupt if ACMPIE (ACMP_CTL1[1]) is set to 1.\nNote: Write 1 to clear this bit to 0.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACMPO0</name>
              <description>ACMP Output 0\nSynchronized to the PCLK to allow reading by software. Cleared when the ACMP0 is disabled, i.e. ACMPEN (ACMP_CTL0[0]) is cleared to 0.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACMPO1</name>
              <description>ACMP Output 1\nSynchronized to the PCLK to allow reading by software. Cleared when the ACMP1 is disabled, i.e. ACMPEN (ACMP_CTL1[0]) is cleared to 0.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WKIF0</name>
              <description>ACMP Power-down Wake-up Interrupt Flag 0\nThis bit will be set to 1 when ACMP0 wake-up interrupt event occurs.\nNote: Write 1 to clear this bit to 0.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No power-down wake-up occurred</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power-down wake-up occurred</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WKIF1</name>
              <description>ACMP Power-down Wake-up Interrupt Flag 1\nThis bit will be set to 1 when ACMP1 wake-up interrupt event occurs.\nNote: Write 1 to clear this bit to 0.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No power-down wake-up occurred</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power-down wake-up occurred</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACMPS0</name>
              <description>ACMP Status 0\nSynchronized to the PCLK to allow reading by software. Cleared when the ACMP 0 is disabled, i.e. ACMPEN (ACMP_CTL0[0]) is cleared to 0.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACMPS1</name>
              <description>ACMP Status 1\nSynchronized to the PCLK to allow reading by software. Cleared when the ACMP1 is disabled, i.e. ACMPEN (ACMP_CTL1[0]) is cleared to 0.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACMPWO</name>
              <description>ACMP Window Output\nThis bit shows the output status of window compare mode\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The positive input voltage is outside the window</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The positive input voltage is in the window</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ACMP_VREF</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ACMP_VREF</displayName>
          <description>Analog Comparator Reference Voltage Control Register</description>
          <addressOffset>0xC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CRV0SEL</name>
              <description>ACMP Reference Voltage Setting 0\nSet CRV output voltage for ACMP0 negtive input.\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>CRV0SSEL</name>
              <description>CRV0 Source Voltage Selection\n</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>AVDD is selected as CRV0 source voltage</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The reference voltage defined by VREFCTL (SYS_VREFCTL[4:0]) register is selected as CRV0 source voltage</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CRV0EN</name>
              <description>CRV0 Enable Bit\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>CRV0 Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CRV0 Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLAMPEN0</name>
              <description>ACMP Speed Up Function Enable Bit\n</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP0 Speed Up Function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP0 Speed Up Function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CRV1SEL</name>
              <description>ACMP Reference Voltage Setting 1\nSet CRV output voltage for ACMP1 negtive input.\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>CRV1SSEL</name>
              <description>CRV1 Source Voltage Selection\n</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>AVDD is selected as CRV1 source voltage</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The reference voltage defined by VREFCTL (SYS_VREFCTL[4:0]) register is selected as CRV1 source voltage</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CRV1EN</name>
              <description>CRV1 Enable Bit\n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>CRV1 Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CRV1 Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLAMPEN1</name>
              <description>ACMP Speed Up Function Enable Bit\n</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP1 Speed Up Function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP1 Speed Up Function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ACMP_CALCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ACMP_CALCTL</displayName>
          <description>Analog Comparator Calibration Control Register</description>
          <addressOffset>0x10</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000050</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CALTRG0</name>
              <description>ACMP Calibration Trigger 0\nSet ACMP0 calibration trigger.\nNote 1: Before this bit is enabled, ACMPEN(ACMP_CTL0[0]) should be set and the internal high speed RC oscillator (HIRC) should be enabled in advance.\nNote 2: Hardware will automatically clear this bit when the next calibration is triggered by software.\nNote 3: If user must trigger calibration twice or more times, the second trigger has to wait at least 300us after the previous calibration is done.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Calibration is stopped</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Calibration is triggered</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CALTRG1</name>
              <description>ACMP Calibration Trigger 1\nSet ACMP1 calibration trigger.\nNote 1: Before this bit is enabled, ACMPEN(ACMP_CTL1[0]) should be set and the internal high speed RC oscillator (HIRC) should be enabled in advance.\nNote 2: Hardware will automatically clear this bit when the next calibration is triggered by software.\nNote 3: If user must trigger calibration twice or more times, the second trigger has to wait at least 300us after the previous calibration is done.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Calibration is stopped</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Calibration is triggered</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CALCLK0</name>
              <description>ACMP Calibration Clock Rate Selection 0\nSet ACMP0 calibration clock rate.\n</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>1.5 kHz</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>6 kHz</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>24 kHz</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>95 kHz</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CALCLK1</name>
              <description>ACMP Calibration Clock Rate Selection 1\nSet ACMP1 calibration clock rate.\n</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>1.5 kHz</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>6 kHz</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>24 kHz</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>95 kHz</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OFFSETSEL</name>
              <description>ACMP Trim Code Selection\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>calibration trim code will not minus 1 when calibrated done</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>calibration trim code will not minus 1 when calibrated done</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CALRVS</name>
              <description>Calibration Reference Voltage Selection \nNote: CRV0 and CRV1 must be the same setting in calibration\nNote: The details refer to Analog ACMP SPEC</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>option0 (N-pair calibration: 5V - 80mV,  P-pair calibration: 80mV)</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>option1</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>option2 (N-pair calibration: 5V - 160mV, P-pair calibration: 160mV)</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Reserved</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ACMP_CALSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ACMP_CALSTS</displayName>
          <description>Analog Comparator Calibration Status Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DONE0</name>
              <description>ACMP Calibration Done Status 0\nThis bit will be set when ACMP0 calibration is done.\nNote: Write 1 to clear this bit to 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Calibrating</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Calibration done</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DONE1</name>
              <description>ACMP Calibration Done Status 1\nThis bit will be set when ACMP1 calibration is done.\nNote: Write 1 to clear this bit to 0.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Calibrating</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Calibration done</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ACMP_COFF</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ACMP_COFF</displayName>
          <description>Analog Comparator Calibration Offset Register</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>NCODE0</name>
              <description>ACMP Offset 0 of NMOS \nACMP0 offset canceling trim code of NMOS\nNote: 1. Once ACMP0 is enabled, reading these bits will gets initial value from ROMMAP46/50[19:16] \n2. write MODESEL ACMP_CTL0[29:28] will decide NCODE0 load from which ROMMAP\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>NSEL0</name>
              <description>ACMP Offset 0 of NMOS\n2. If ACMP0 is enabled and CALTRG0 (ACMP_CALCTL[0]]) is set, after calibration done DONE0(ACMP_CALSTS[0]) will get NSEL0 value</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>trim NMOS negative offset</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>trim NMOS positive offset</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PCODE0</name>
              <description>ACMP Offset 0 of PMOS \nACMP0 offset canceling trim code of PMOS\nNote: 1. Once ACMP0 is enabled, reading these bits default will get initial value from ROMMAP46/50[27:24]\n2. write MODESEL ACMP_CTL0[29:28] will decide PCODE0 load from which ROMMAP\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PSEL0</name>
              <description>ACMP Offset 0 of PMOS\n3. If ACMP0 is enabled and CALTRG0 (ACMP_CALCTL[0]]) is set, after calibration done DONE0(ACMP_CALSTS[0]) will get PSEL0 value</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>trim PMOS negative offset</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>trim PMOS positive offset</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NCODE1</name>
              <description>ACMP Offset 1 of NMOS \nACMP1 offset canceling trim code of PMOS\nNote: 1. Once ACMP1 is enabled, reading these bits default will get initial value from ROMMAP48/52[19:16]\n2. write MODESEL ACMP_CTL1[29:28] will decide NCODE1 load from which ROMMAP\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>NSEL1</name>
              <description>ACMP Offset 1 of NMOS\n3. If ACMP1 is enabled and CALTRG1 (ACMP_CALCTL[1]]) is set, after calibration done DONE1(ACMP_CALSTS[4]) will get NSEL1 value</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>trim NMOS negative offset</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>trim NMOS positive offset</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PCODE1</name>
              <description>ACMP Offset 1 of PMOS \nACMP1 offset canceling trim code of PMOS\nNote: 1. Once ACMP1 is enabled, reading these bits default will get initial value from ROMMAP48/52[27:24]\n2. write MODESEL ACMP_CTL1[29:28] will decide PCODE1 load from which ROMMAP\n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PSEL1</name>
              <description>ACMP Offset 1 of PMOS\n      3. If ACMP1 is enabled and CALTRG1 (ACMP_CALCTL[1]]) is set, after calibration done DONE1(ACMP_CALSTS[4]) will get PSEL1 value</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>trim PMOS negative offset</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>trim PMOS positive offset</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ACMP_HYSOFF</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ACMP_HYSOFF</displayName>
          <description>Analog Comparator Hysteresis Offset</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HYSN0</name>
              <description>The N-differential pair of ACMP interface control 0\nHYSN0 can monitor whether interface control of hysteresis to meet expectation for ACMP0.\n         b. 4'b0000 reload by reset.\n         c. Software write register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>HYSP0</name>
              <description>The P-differential pair of ACMP interface control 0\nHYSP0 can monitor whether interface control of hysteresis to meet expectation for ACMP0.\n         b. 4'b0000 reload by reset.\n         c. Software write register.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>HYSN1</name>
              <description>The N-differential pair of ACMP interface control 1\nHYSN0 can monitor whether interface control of hysteresis to meet expectation for ACMP1.\n         b. 4'b0000 reload by reset.\n         c. Software write register.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>HYSP1</name>
              <description>The P-differential pair of ACMP interface control 1\nHYSP0 can monitor whether interface control of hysteresis to meet expectation for ACMP1.\n         b. 4'b0000 reload by reset.\n         c. Software write register.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ACMP_TEST</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ACMP_TEST</displayName>
          <description>Analog Comparator Test Mode Control Register</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CRV0TEST</name>
              <description>CRV0 Test Mode Enable Bit (Write Protect)\nThis bit is designed for Nuvoton Lab use only.\nNote: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote: 1.NEGSEL (ACMP_CTL0[6:4]) or NEGSEL (ACMP_CTL1[6:4]) must select to 3'b001 in CRV test mode\n      2.NEGSEL (ACMP_CTL0[6:4]) or NEGSEL (ACMP_CTL1[6:4]) must select to 3'b010  in VBG test mode.\n      3.ACMPEN (ACMP_CTL0[0]) or ACMPEN (ACMP_CTL1[0]) must select to 1'b1  in VBG test mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No effect</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CRV voltage output to ACMP0_N pin for voltage measure</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CRV1TEST</name>
              <description>CRV1 Test Mode Enable Bit (Write Protect)\nThis bit is designed for Nuvoton Lab use only.\nNote: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote: 1.NEGSEL (ACMP_CTL0[6:4]) or NEGSEL (ACMP_CTL1[6:4]) must select to 3'b001 in CRV test mode\n      2.NEGSEL (ACMP_CTL0[6:4]) or NEGSEL (ACMP_CTL1[6:4]) must select to 3'b010  in VBG test mode.\n      3.ACMPEN (ACMP_CTL0[0]) or ACMPEN (ACMP_CTL1[0]) must select to 1'b1  in VBG test mode.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No effect</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CRV voltage output to ACMP1_N pin for voltage measure</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PDNPAIR0</name>
              <description>ACMP Power Down N-Intput Pair 0\n</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP0 normal</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP0 power down N-input pair</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PDNPAIR1</name>
              <description>ACMP Power Down N-Intput Pair 01\n</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP1 normal</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP1 power down N-input pair</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OUTSEL0</name>
              <description>ACMP CRV Output Source Selection 0\nSet CRV output source selection for ACMP0.\n</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>CRV0 output from resistor string</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CRV0 output from band-gap voltage</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OUTSEL1</name>
              <description>ACMP CRV Output Source Selection 1\nSet CRV output source selection for ACMP1.\n</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>CRV1 output from resistor string</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CRV1 output from band-gap voltage</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OTEN0</name>
              <description>ACMP OFFSET Test Mode Enable Bits 0\nSet offset test for ACMP0.\nNote: If offset test mode enable, the ACMPx_N0 should add 1uF cap and ACMP will become an unity gain buffer. User can measure P0 channel and N0 channel voltage to get offset value.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP0 offset test mode Disable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP0 offset test mode Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OTEN1</name>
              <description>ACMP OFFSET Test Mode Enable Bits 1\nSet offset test for ACMP1.\nNote: If offset test mode enable, the ACMPx_N0 should add 1uF cap and ACMP will become an unity gain buffer. User can measure P0 channel and N0 channel voltage to get offset value.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP1 offset test mode Disable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP1 offset test mode Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HYSBYP0</name>
              <description>ACMP Hysteresis Adjust Function Selectionm0\nSet hysteresis adjust function for ACMP0.\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>adjust function is enabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>adjust function is bypass</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HYSBYP1</name>
              <description>ACMP Hysteresis Adjust Function Selection 1\nSet hysteresis adjust function for ACMP1.\n</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>adjust function is enabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>adjust function is bypass</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PDPPAIR0</name>
              <description>ACMP Power Down P-Intput Pair 0\n</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP0 normal</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP0 power down P-input pair</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PDPPAIR1</name>
              <description>ACMP Power Down P-Intput Pair 1\n</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP1 normal</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP1 power down P-input pair</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TESTHYSSEL0</name>
              <description>ACMP Feedback Test Mode Hysteresis Select Control Pin 0\n</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP0 generate 0~+hysteresis/2</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP0 generate 0~-hysteresis/2</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TESTHYSSEL1</name>
              <description>ACMP Feedback Test Mode Hysteresis Select Control Pin 1\n</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACMP1 generate 0~+hysteresis/2</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ACMP1 generate 0~-hysteresis/2</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ACMP_VERSION</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ACMP_VERSION</displayName>
          <description>Analog Comparator RTL Design Version Number</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <resetValue>0x02020000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MINOR</name>
              <description>Comp RTL Design MINOR Version Number\nMinor version number is dependent on module ECO version control.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>Comp RTL Design SUB Version Number\nMajor version number is correlated to Product Line.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>MAJOR</name>
              <description>Comp RTL Design MAJOR Version Number\nMajor version number is correlated to Product Line.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CACHE_NS</name>
      <description>CACHE Register Map</description>
      <groupName>CACHE</groupName>
      <baseAddress>0x50036000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>CACHE_CTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CACHE_CTL</displayName>
          <description>CACHE Control Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CACHEEN</name>
              <description>Cache Enable Bit\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>cache disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>cache enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HITMEN</name>
              <description>Hit Monitor Enable Bit\n0: cache hit monitor stops counting and does not reset.\n1: cache hit monitor enable.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MISSMEN</name>
              <description>Miss Monitor Enable Bit\n0: cache miss monitor stops counting and does not reset.\n1: cache miss monitor enable.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HITMRST</name>
              <description>HIT monitor reset\n0: no effect.\n1: reset the cache hit monitor.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MISSMRST</name>
              <description>Miss monitor reset\n0: no effect.\n1: reset the cache miss monitor.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>CACHE_STS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CACHE_STS</displayName>
          <description>CACHE Status Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BUSY</name>
              <description>Cache Busy Flag\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>cache not busy on a invalidate operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>cache executing a invalidate operation</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>CACHE_HIT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CACHE_HIT</displayName>
          <description>CACHE Hit Monitor Register</description>
          <addressOffset>0x8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Cachehitmonitor</name>
              <description>Cache hit monitor counter.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>CACHE_MISS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CACHE_MISS</displayName>
          <description>CACHE Miss Monitor Register</description>
          <addressOffset>0xC</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Cachemissmonitor</name>
              <description>Cache miss monitor counter.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>ELLSI0_NS</name>
      <description>ELLSI Register Map</description>
      <groupName>ELLSI</groupName>
      <baseAddress>0x5008A000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0xC4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>ELLSI_CTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CTL</displayName>
          <description>ELLSI Control Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELLSIEN</name>
              <description>ELLSI Enable Bit\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ELLSI Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ELLSI Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSTCEN</name>
              <description>Reset Command Function Enable Bit\nNote: If this bit is enabled, when FIFO and shift register are both empty, ELLSI will send reset command out.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Reset command function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Reset command function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNDFLINTEN</name>
              <description>Underflow Interrupt Enable Bit\nNote: If this bit is enabled, when the UNDFLIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Underflow interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Underflow interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FENDINTEN</name>
              <description>Frame End Interrupt Enable Bit\nNote: If this bit is enabled, when the FENDIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Frame end interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Frame end interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSTCINTEN</name>
              <description>Reset Command Interrupt Enable Bit\nNote: If this bit is enabled, when the RSTCIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Reset command interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Reset command interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EMPINTEN</name>
              <description>FIFO Empty Interrupt Enable Bit\nNote: If this bit is enabled, when the EMPIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>FIFO empty interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>FIFO empty interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FULINTEN</name>
              <description>FIFO Full Interrupt Enable Bit\nNote: If this bit is enabled, when the FULIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>FIFO full interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>FIFO full interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTHIEN</name>
              <description>Transmit FIFO Threshold Interrupt Enable Bit\nNote: This bit is only supported in software mode.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>TX FIFO threshold interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>TX FIFO threshold interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ELLSIMODE</name>
              <description>ELLSI Mode Select\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Software mode</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PDMA mode</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OFDEF</name>
              <description>Output Format Define\n</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Output RGB format</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Output GRB format</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTH</name>
              <description>Transmit FIFO Threshold\nIf the valid data count of the transmit FIFO buffer is less than or equal to the TXTH setting, the TXTHIF bit will be set to 1, else the TXTHIF bit will be cleared to 0.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CMDMODE</name>
              <description>Command Mode\n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>LLSI Mode</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Normal Command mode</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>AUTO SET Mode. It includes CLR_ID, Set_ID, CHK_ID, SPE_ID and Feedback mode</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>AUTO TH20 SET Mode</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NCMDDIEN</name>
              <description>Normal Command Done Interrupt Enable\n</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Command done interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Command done interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSPIEN</name>
              <description>Normal Command Response Error Interrupt Enable\nNote: Normal Command Responses are SET_ID, CHK_ID, and the error flags are ELLSI_CMDSTS[13:8]</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Normal Command Response(SET,CHK, ) Error Interrupt Disable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Normal Command Response Error Interrupt Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FBSTSIEN</name>
              <description>Feedback Status Interrupt Enable\n</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Feedback Status Interrupt Disable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Feedback Status Interrupt Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ASETIEN</name>
              <description>Auto Set Mode Interrupt Enable\n</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Auto Set Mode Interrupt Disable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Auto Set Mode Interrupt Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ATHIEN</name>
              <description>AUTO TH20 Mode Interrupt Enable\n</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>AUTO TH20 Mode Interrupt Disable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>AUTO TH20 Mode Interrupt Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_RSTPERIOD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_RSTPERIOD</displayName>
          <description>ELLSI Reset Period Control Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSTPERIOD</name>
              <description>Reset Command Period\nThis field is used to adjust the time of reset command.\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_PERIOD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_PERIOD</displayName>
          <description>ELLSI Period Control Register</description>
          <addressOffset>0x8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PERIOD</name>
              <description>ELLSI Period Register\nThis field is used to define data transfer time (TH+TL).\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_DUTY</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_DUTY</displayName>
          <description>ELLSI Duty Control Register</description>
          <addressOffset>0xC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>T0H</name>
              <description>T0H Data Register\nThis field is used to define the time of T0H.\nThe time of \n&#55349;&#56391;\n&#55349;&#56391;0&#55349;&#56379;\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>T1H</name>
              <description>T1H Data Register\nThis field is used to define the time of T1H.\nThe time of \n&#55349;&#56391;\n&#55349;&#56391;1&#55349;&#56379;\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_DATA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_DATA</displayName>
          <description>ELLSI Data Register</description>
          <addressOffset>0x10</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA</name>
              <description>Data Transmit Register \nThe data transmit registers pass through the transmitted data into the 4-level transmit FIFO buffers.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_PCNT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_PCNT</displayName>
          <description>ELLSI Pixel Count Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PCNT</name>
              <description>Pixel Count Register\nUser should write a frame size to this register before transfer.\nFor example, if there are a total of 5 LED (5 pixels) in frame, user should write 5 to this control register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CLKDIV</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CLKDIV</displayName>
          <description>ELLSI Clock Divider Register</description>
          <addressOffset>0x18</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DIVIDER</name>
              <description>ELLSI Clock Divider\nIt indicates the ELLSI clock, \n&#55349;&#56403;\n&#55349;&#56383;&#55349;&#56383;&#55349;&#56390;&#55349;&#56380;\n\n&#55349;&#56403;\n&#55349;&#56372;&#55349;&#56387;&#55349;&#56373;&#55349;&#56374;&#55349;&#56383;&#55349;&#56382;\n\n\n&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;&#55349;&#56380;&#55349;&#56375;&#55349;&#56376;&#55349;&#56389;+1</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>CMDDIV</name>
              <description>ELLSI Command Clock Divider\nIt indicates the ELLSI command clock, \n&#55349;&#56403;\n&#55349;&#56376;&#55349;&#56383;&#55349;&#56383;&#55349;&#56390;&#55349;&#56380;_&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;\n\n&#55349;&#56403;\n&#55349;&#56372;&#55349;&#56387;&#55349;&#56373;&#55349;&#56374;&#55349;&#56383;&#55349;&#56382;\n\n\n&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;&#55349;&#56380;&#55349;&#56375;&#55349;&#56376;&#55349;&#56389;+1\n(&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;+1)</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_STATUS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_STATUS</displayName>
          <description>ELLSI Status Register</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSTCIF</name>
              <description>Reset Command Interrupt Flag\nThis bit indicates that ELLSI has finished reset command transmission.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EMPIF</name>
              <description>FIFO Empty Interrupt Flag\n</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Transmit FIFO buffer is not empty</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Transmit FIFO buffer is empty</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FULIF</name>
              <description>FIFO Full Interrupt Flag\n</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Transmit FIFO buffer is not full</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Transmit FIFO buffer is full</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTHIF</name>
              <description>Transmit FIFO Threshold Interrupt Flag\n</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The valid data count within the transmit FIFO buffer is larger than the setting value of TXTH</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The valid data count within the transmit FIFO buffer is less than or equal to the setting value of TXTH</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNDFLIF</name>
              <description>Under Flow Interrupt Flag\nEach transmission ELLSI reads 3 bytes data from the FIFO. This bit is set to 1 when ELLSI reads the FIFO and the valid data in FIFO is less than 3 bytes.\nSoftware can write 1 to clear this bit.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FENDIF</name>
              <description>Frame End Interrupt Flag\nThis bit indicates that ELLSI has finished data transmission (FIFO empty &amp; shift register empty). When ELLSI transfer finish (FIFO empty &amp; shift register empty) this bit is set to 1.\nUser can use this flag to prepare data in advance.\nSoftware can write 1 to clear this bit.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LDT</name>
              <description>Last Data Transmit\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_OCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_OCTL</displayName>
          <description>ELLSI Output Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IDOS</name>
              <description>Idle Output Control\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Idle will output 0</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Idle will output 1</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CMDCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CMDCTL</displayName>
          <description>ELLSI Command Control Register</description>
          <addressOffset>0x24</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ENTERLO</name>
              <description>Enter Command Low Period\nEnter Command Low Period(10us). &#55349;&#56387;&#55349;&#56402;&#55349;&#56415;&#55349;&#56406;&#55349;&#56412;\n&#55349;&#56401;\n&#55349;&#56376;&#55349;&#56411;&#55349;&#56417;&#55349;&#56402;&#55349;&#56415;&#55349;&#56383;&#55349;&#56386;\n&#55349;&#56391;\n&#55349;&#56376;&#55349;&#56383;&#55349;&#56383;&#55349;&#56380;_&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;\n&#8727;&#55349;&#56376;&#55349;&#56385;&#55349;&#56391;&#55349;&#56376;&#55349;&#56389;&#55349;&#56383;&#55349;&#56386;</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ENTERHI</name>
              <description>Enter Command HI Period\nEnter Command HI Period(40us). &#55349;&#56387;&#55349;&#56402;&#55349;&#56415;&#55349;&#56406;&#55349;&#56412;\n&#55349;&#56401;\n&#55349;&#56376;&#55349;&#56411;&#55349;&#56417;&#55349;&#56402;&#55349;&#56415;&#55349;&#56379;&#55349;&#56380;\n&#55349;&#56391;\n&#55349;&#56376;&#55349;&#56383;&#55349;&#56383;&#55349;&#56380;_&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;\n&#8727;&#55349;&#56376;&#55349;&#56385;&#55349;&#56391;&#55349;&#56376;&#55349;&#56389;&#55349;&#56379;&#55349;&#56380;</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CMDGPP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CMDGPP</displayName>
          <description>ELLSI Command Get Pulse Period Register</description>
          <addressOffset>0x28</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDTOP</name>
              <description>Command Timeout Period Register\nTime period of the command timeout.\n&#55349;&#56387;&#55349;&#56402;&#55349;&#56415;&#55349;&#56406;&#55349;&#56412;\n&#55349;&#56401;\n&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;&#55349;&#56391;&#55349;&#56386;&#55349;&#56387;\n\n&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;&#55349;&#56380;&#55349;&#56375;&#55349;&#56376;&#55349;&#56389;+1\n(&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;+1)\n\n&#55349;&#56403;\n&#55349;&#56372;&#55349;&#56387;&#55349;&#56373;&#55349;&#56374;&#55349;&#56383;&#55349;&#56382;\n\n&#8727;&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;&#55349;&#56391;&#55349;&#56386;&#55349;&#56387;</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>GETHIP</name>
              <description>Get HI Pulse Period Register\nTime period threshold to check HI Pulse. \n&#55349;&#56387;&#55349;&#56402;&#55349;&#56415;&#55349;&#56406;&#55349;&#56412;\n&#55349;&#56401;\n&#55349;&#56378;&#55349;&#56376;&#55349;&#56391;&#55349;&#56379;&#55349;&#56380;\n\n&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;&#55349;&#56380;&#55349;&#56375;&#55349;&#56376;&#55349;&#56389;+1\n(&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;+1)\n\n&#55349;&#56403;\n&#55349;&#56372;&#55349;&#56387;&#55349;&#56373;&#55349;&#56374;&#55349;&#56383;&#55349;&#56382;\n\n&#8727;&#55349;&#56378;&#55349;&#56376;&#55349;&#56391;&#55349;&#56379;&#55349;&#56380;&#55349;&#56387;</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>GETHITOL</name>
              <description>Get HI Pulse Tolerance Register\nIt can set tolerance Get HI Pulse Period.\n &#55349;&#56387;&#55349;&#56402;&#55349;&#56415;&#55349;&#56406;&#55349;&#56412;\n&#55349;&#56401;\n&#55349;&#56378;&#55349;&#56376;&#55349;&#56391;&#55349;&#56379;&#55349;&#56380;&#55349;&#56391;&#55349;&#56386;&#55349;&#56383;\n&#55349;&#56401;\n&#55349;&#56378;&#55349;&#56376;&#55349;&#56391;&#55349;&#56379;&#55349;&#56380;\n+\n\n&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;&#55349;&#56380;&#55349;&#56375;&#55349;&#56376;&#55349;&#56389;+1\n(&#55349;&#56374;&#55349;&#56384;&#55349;&#56375;&#55349;&#56375;&#55349;&#56380;&#55349;&#56393;+1)\n\n&#55349;&#56403;\n&#55349;&#56372;&#55349;&#56387;&#55349;&#56373;&#55349;&#56374;&#55349;&#56383;&#55349;&#56382;\n\n&#8727;&#55349;&#56378;&#55349;&#56376;&#55349;&#56391;&#55349;&#56379;&#55349;&#56380;&#55349;&#56391;&#55349;&#56386;&#55349;&#56383;</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CMD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CMD</displayName>
          <description>ELLSI Command Register</description>
          <addressOffset>0x2C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ID</name>
              <description>4-bit Command ID\n4-bit ID.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CMD</name>
              <description>4-bit Command\n4-bit command.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CMDGO</name>
              <description>Command Go Bit\nWhen this bit is set, it starts the command.\nThis bit will be cleard automatically by hardware.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SPECMD</name>
              <description>Special Command\n</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Normal command or no command</description>
                    <value>#0000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Feedback count command</description>
                    <value>#0001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Feedback ID command</description>
                    <value>#0010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>TH20 SET command</description>
                    <value>#0011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>Send Data</description>
                    <value>#0100</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PDCMD</name>
              <description>Power-down Command\nWhen sending data, user can use this bit to send 0x5a after data.\nThis bit will be cleard automatically by hardware.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WKCMD</name>
              <description>Wakeup Command\nWhen sending data, user can use this bit to send wakeup pulse after data.\nThis bit will be cleard automatically by hardware after receiving low pulse.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CMDSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CMDSTS</displayName>
          <description>ELLSI Command Status Register</description>
          <addressOffset>0x30</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDDONE</name>
              <description>Normal Command Done\nIt will be set 1 when Command(SET_ID, CLR_ID, CHK_ID) done in Normal Command Mode.\nSoftware can write 1 to clear this bit.\nNote: NCMDDIEN (ELLSI_CTL[27]) need to be set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBDONE</name>
              <description>Feedback Command Done\nIt will be set 1 when Feedback Command done in Normal Command Mode.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TH20DONE</name>
              <description>TH20 Command Done Flag\nIt will be set 1 when TH20 SET Command done in Normal Command Mode.\nSoftware can write 1 to clear this bit.\nNote: NCMDDIEN (ELLSI_CTL[27]) need to be set.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SETIDLONG</name>
              <description>Set ID Get Pulse Long Flag\nIt will be set 1 when the pulse longer than tolerance at Set ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHKIDLONG</name>
              <description>Check ID Get Pulse Long Flag\nIt will be set 1 when the pulse longer than tolerance at Check ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SETIDSHORT</name>
              <description>Set ID Get Pulse Short Flag\nIt will be set 1 when the pulse shorter than tolerance at Set ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHKIDSHORT</name>
              <description>Check ID Get Pulse Short Flag\nIt will be set 1 when the pulse shorter than tolerance at Check ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SETGETOV</name>
              <description>SET ID Get Pulse Overflow Flag\nIt will be set 1 when ELLSI receive more than one pulse at the Set ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHKGETOV</name>
              <description>Check ID Get Pulse Overflow Flag\nIt will be set 1 when ELLSI receive more than one pulse at the Check ID Command Get pulse phase.\nSoftware can write 1 to clear this bit\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SETGETUN</name>
              <description>SET ID Get Pulse Underflow Flag\nIt will be set 1 when ELLSI receive less than one pulse at the Set ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHKGETUN</name>
              <description>Check ID Get Pulse Underflow Flag\nIt will be set 1 when ELLSI receive less than one pulse at the Check ID Command Get pulse phase.\nSoftware can write 1 to clear this bit\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBC0LONG</name>
              <description>Feedback Count 0 Pulse Long Flag\nIt will be set 1 when the feedback count pulse longer than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBC0SHORT</name>
              <description>Feedback Count 0 Pulse Short Flag\nIt will be set 1 when the feedback count pulse shorter than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBC1LONG</name>
              <description>Feedback Count 1 Pulse Long Flag\nIt will be set 1 when the feedback count pulse longer than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBC1SHORT</name>
              <description>Feedback Count 1 Pulse Short Flag\nIt will be set 1 when the feedback count pulse shorter than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBID0LONG</name>
              <description>Feedback ID 0 Pulse Long Flag\nIt will be set 1 when the feedback ID pulse longer than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBID0SHORT</name>
              <description>Feedback ID 0 Pulse Short Flag\nIt will be set 1 when the feedback ID pulse shorter than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBID1LONG</name>
              <description>Feedback ID 1 Pulse Long Flag\nIt will be set 1 when the feedback ID pulse longer than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBID1SHORT</name>
              <description>Feedback ID 1 Pulse Short Flag\nIt will be set 1 when the feedback ID pulse shorter than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ASETIDOV</name>
              <description>AUTO SET Mode Feedback ID Overflow Flag\nIt will be set 1 when setting ID 4b'1111, and get two pulses back.\nSoftware can write 1 to clear this bit.\nNote: ASETIEN(ELLSI_CTL[30]) need to be set.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ASETDONE</name>
              <description>AUTO SET Mode Done Flag\nIt will be set 1 when AUTO SET Mode is done.\nSoftware can write 1 to clear this bit.\nNote: ASETIEN(ELLSI_CTL[30]) need to be set.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ATHDONE</name>
              <description>AUTO TH20 SET Mode Done Flag\nIt will be set 1 when AUTO TH20 SET Mode is done.\nSoftware can write 1 to clear this bit.\nNote: ATHIEN(ELLSI_CTL[31]) need to be set.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IDCNT</name>
              <description>ID Count Register\nNumber of Feedback Pulse. It can also be set when the register is written.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>

          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SELFTEST</name>
              <description>BPWM Self-test Mode Enable Bit(Write Protect)\nWhen BPWM self-test mode enabled, the BPWM0 capture input source comes from BPWM1 output, and BPWM1 capture input source comes from BPWM0 output. \nNote: This bit is write protected. Refer to&#160;SYS_REGLCTL register.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>BPWM self-test mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BPWM self-test mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>

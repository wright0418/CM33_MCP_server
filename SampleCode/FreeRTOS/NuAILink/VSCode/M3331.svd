          <name>HSUSBD_EPJINTSTS</name>
          <displayName>HSUSBD_EPJINTSTS</displayName>
          <description>Endpoint J Interrupt Status Register</description>
          <addressOffset>0x1D0</addressOffset>
       </register>
       <register derivedFrom="HSUSBD_EPAINTEN">

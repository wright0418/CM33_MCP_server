       <register>
          <name>SYS_TESTBUF</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_TESTBUF</displayName>
          <description>Testbuf Control Register</description>
          <addressOffset>0x1A0</addressOffset>

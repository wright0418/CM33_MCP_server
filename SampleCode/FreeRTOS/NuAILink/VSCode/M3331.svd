                    <value>#011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>Synchronous start source come from BPWM2</description>
                    <value>#100</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>5</name>
                    <description>Synchronous start source come from BPWM3</description>
                    <value>#101</value>
                 </enumeratedValue>
                 <enumeratedValue>

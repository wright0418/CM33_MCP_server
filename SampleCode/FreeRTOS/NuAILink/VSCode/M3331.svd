          <fields>
            <field>
              <name>HSREN0</name>
              <description>Port A-H Pin[n] High Slew Rate Control\nNote 2: Please refer to the Datasheet for detailed pin operation voltage information about VDD electrical characteristics.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Px.n output with normal slew rate mode (maximum 40 MHz at 2.7V)</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Px.n output with high slew rate mode (maximum 80 MHz at 2.7V)</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Px.n output with fast slew rate mode (maximum 100 MHz at 2.7V)</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Reserved</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSREN1</name>
              <description>Port A-H Pin[n] High Slew Rate Control\nNote 2: Please refer to the Datasheet for detailed pin operation voltage information about VDD electrical characteristics.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Px.n output with normal slew rate mode (maximum 40 MHz at 2.7V)</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Px.n output with high slew rate mode (maximum 80 MHz at 2.7V)</description>

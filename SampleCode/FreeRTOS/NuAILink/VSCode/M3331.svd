          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SECn</name>
              <description>Set SRAM Section n to Non-secure State\nWrite 1 to set SRAM section n to non-secure state. \nFor bit0 to bit15, it configures the size per section is 8 Kbytes, ranging from 0x2000_0000 to 0x2000_0000 +16 * 0x2000-1.\nFor bit16 to bit27, it configures the size per section is 16 Kbytes, ranging from 0x2002_0000 to 0x2002_0000 +12 * 0x4000-1.\nNote: This bit is write-protected by SCU_SCWP.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>28</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>SRAM Section n is secure (default)</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>SRAM Section n is non-secure</description>
                    <value>1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>

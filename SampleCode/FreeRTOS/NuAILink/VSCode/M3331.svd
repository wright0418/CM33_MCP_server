       <register>
          <name>BPWM_VERSION</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>BPWM_VERSION</displayName>
          <description>BPWM RTL Design Version Number</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <resetValue>0x02010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MINOR</name>
              <description>RTL Design MINOR Version Number (Read Only)\nMinor version number is dependent on ECO version control.\n0x0000: (current Minor Version Number).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>SUB</name>
              <description>RTL Design SUB Version Number (Read Only)\nSub version number is relative to key feature.\n0x02: (current Sub Version Number).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>MAJOR</name>
              <description>RTL Design MAJOR Version Number (Read Only)\nMajor version number is correlated to Product Line.\n0x01: (current Major Version Number).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
      </registers>

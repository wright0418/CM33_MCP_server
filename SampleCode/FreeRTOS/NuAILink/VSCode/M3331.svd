              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>SRAM bank1 clock Disabled when chip is under IDLE mode if all following IP clock is disabled (EMAC, CCAP, SDH0, SDH1, HSUSBD, HSUSBH, USBH, Crypto, SPIM, PDMA0)</description>
                    <value>#0</value>

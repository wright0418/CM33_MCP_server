                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Interrupt assigned to CAN interrupt line 1</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RF0WL</name>

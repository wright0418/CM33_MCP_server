                    <name>1</name>
                    <description>CMP25N Disabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F_BG_EN</name>
              <description>Force MEGBIAS Enable Bit\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>

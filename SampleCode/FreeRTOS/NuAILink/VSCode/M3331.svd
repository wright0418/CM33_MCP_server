        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x280</offset>
        <size>0x1C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x500</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>I3C_DEVCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_DEVCTL</displayName>
          <description>I3C Device Control Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IBAINCL</name>
              <description>I3C Broadcast Address include\nThis bit is used in Master mode of operation. This bit is used to include DWC_mipi_i3c broadcast address (0x7E) for private transfer.\nNote: If I3C broadcast address is not included for the private transfers, In-band Interrupts (IBI) driven from Slaves might not win address arbitration. Hence, the IBIs get delayed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>I3C Broadcast Address is not included for Private Transfer</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>I3C Broadcast Address is included for Private Transfers</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PENDINT</name>
              <description>Pending Interrupt Status\nThis field is used in Slave mode of operation. \nThis field is used for setting the interrupt number and is also reflected in I3C_CCCSTS[3:0] PENDINT.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>HJCTL</name>
              <description>Hot-Join ACK/NACK Control \nThis bit is used in master mode of operation. This bit acts as a global control to ACK/NACK the Hot-Join request from the devices. The I3C Master ACK/NACKs the Hot-Join request from other devices connected on the I3C bus, based on programming of this bit.\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACK the Hot-join request</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>NACK and send broadcast CCC to disable Hot-Join</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TSCEN</name>
              <description>Timestamp Counter Enable Bit\n</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Timestamp counter Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Timestamp counter Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TSCCLR</name>
              <description>Timestamp Counter Clear Bit\nThis bit will be cleared by hardware automatically.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Clear timestamp counter Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Clear Clear timestamp counter Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IBIPSIZE</name>
              <description>Slave maximum IBI payload size\nThis value is I3C Target  IBI Payload Size if the Controller sends a GETMRL/SETMRL CCC.\nNote: This field is read only.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IDLECNT</name>
              <description>Idle Count Multiplier \nThis bit is used in Slave mode of operation. After power-on reset, the Slave controller is enabled only after it sees both SDA and SCL lines idle for a specified time. This idle time is calculated by multiplying IDLE_ MUL with BUS_AVAILABLE_TIME field in the BUS_FREE_AVAIL_TIMING register. \n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>BUS_AVAILABLE_TIME * 1</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BUS_AVAILABLE_TIME * 2</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>BUS_AVAILABLE_TIME * 4</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>BUS_AVAILABLE_TIME * 8</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TPECEN</name>
              <description>TARGET PEC Enable Updated Status.\nApplication to enable Packet Error Check. The application programs this field before enabling the Target.\n</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PEC support is not enabled</description>
                    <value>0x0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PEC support is enabled</description>
                    <value>0x1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADAPTIVE</name>
              <description>Adaptive Mode\n(effect on HJ operation)\nThis field is used in Slave mode of operation. Setting of this bit is NOT required to put the controller in Adaptive Mode. It is only used to enable some features of the Slave controller to adapt to &quot;Adaptive I2C/I3C mode&quot; of operation. This bit is cleared automatically if the controller determines the mode as I3C. Effect on Hot- Join: If this bit is programmed to 1'b1, the controller initiates a Hot-Join request only after it has switched to I3C mode of operation. If this bit is not set, the controller initiates a Hot- Join without determining the bus mode assuming itself to be on i3c bus. This bit should be set only if the Slave application does not know to which bus the device is connected to.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DMAEN</name>
              <description>DMA Handshake Interface Enable \n</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The DMA handshake control has no significance</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Enables the DMA handshake control to interact with external DMA</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ABORT</name>
              <description>Abort Bit\nThis bit is used in Master mode of operation This bit allows the controller to relinquish the I3C bus before completing the issued transfer In response to an ABORT request, the controller issues the STOP condition after the complete data byte is transferred or received\nThis bit is auto-cleared once the transfer is aborted and the controller issues a 'Transfer Abort' interrupt.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RESUME</name>
              <description>I3C Resume Bit\nThis bit is used to resume the controller after it goes to the halt state.\nNote: This bit is cleared by writing 1 to it.\nIn the Master mode of operation, the controller goes to the halt state due to any type of error in the transfer. After the controller gones to the halt state, the application has to write 1'b1 to this bit to resume the controller. This bit is auto-cleared once the controller resumes the transfers by initiating the next command.\nIn the Slave mode of operation, the controller goes to the halt state due to following conditions:\n&#9632; Any type of error in the transfer \n&#9632; MRL Register updated by the master through SETMRL CCC. \nAfter the controller goes to the halt state, the application has to take necessary action to handle the error condition and then write 1'b1 to this bit to resume the controller. This bit is auto-cleared once the controller is ready to accept new transfers.\n(RESUME cannot auto-clear until GETSTATS CCC is received .if Slave has Protocol Error)</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>RESUME operation is completion</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>RESUME operation is in progress</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Controls whether or not I3C is enabled\nNote:\n1.To Enable the Slave controller, the application must set the ENABLE bit to 1. Enabling the Slave controller might not be instantaneous because it is dependent on the availability of SCL clock on the I3C line.\n2.To Disable the Slave controller, the application after setting the value of 0 to the ENABLE bit must keep polling the ENABLE bit to check whether the bit value is zero. Once the ENABLE bit is read with a value of zero, the application can be sure that the Slave controller is disabled. If the SCL clock is present, the Slave controller takes two SCL clocks to come out of the Disable state.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>I3C controller Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>I3C controller Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_DEVADDR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_DEVADDR</displayName>
          <description>I3C Device Address Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00008000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SA</name>
              <description>Device Static Address\nThe slave controller uses this address to respond to SETDASA CCC Command to get the Dynamic Address or performs Legacy I2C Read/Write operation.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>SAVALID</name>
              <description>Static Address Valid\nIn slave mode of operation this bit reflects the value of static_addr_en input port. The input port static_addr_en is expected to be driven to 1 only if the device supports I2C or I3C Static Address. \n</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Static Address is invalid</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Static Address is valid</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DA</name>
              <description>Device Dynamic Address\nIn Master mode, the user/application has to program the Dynamic Address through the Slave interface as it self-assigns its Dynamic Address.\nIn Slave mode, this field is used to indicate the device Dynamic Address after slave completes the dynamic address assignment operation by ENTDAA, SETDASA or SETNEDA CCC.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>DAVALID</name>
              <description>Dynamic Address Valid \nIn Master mode, the user sets this bit to 1 as it self-assigns its dynamic address.\nIn I3C Slave Mode the Controller sets this bit to 1 when Main Master assigns the Dynamic address during ENTDAA or SETDASA mechanism.\nNote: This bit can be auto-clear to 0 if RSTDAA CCC is reveived.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Dynamic Address is invalid</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Dynamic Address is valid</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_HWCAP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_HWCAP</displayName>
          <description>I3C Hardware Capability Register</description>
          <addressOffset>0x8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00BF41AB</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DEVROLE</name>
              <description>Specifies the configured role of I3C controller\n 1: Master Only\n 2: Programmable Master-Slave\n 3: Secondary Master\n 4: Slave Only</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>HDRDDREN</name>
              <description>Reflects the IC_SPEED_HDR_DDR Configurable Parameter Specifies the Controllers capability to perform HDR-DDR transfers\n 0: HDR-DDR not supported\n 1: HDR-DDR supported</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HDRTSEN</name>
              <description>Reflects the IC_SPEED_HDR_TS Configurable Parameter Specifies the Controllers capability to perform HDR-TS transfers\n0: HDR-TS not supported\n1: HDR-TS supported</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLKP</name>
              <description>Reflects the IC_CLK_PERIOD Configurable Parameter</description>
              <bitOffset>5</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>HDRTCLKP</name>
              <description>Reflects the IC_HDR_TX_CLK_PERIOD Configurable Parameter</description>
              <bitOffset>11</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>DMAEN</name>
              <description>Reflects the IC_HAS_DMA Configurable Parameter Specifies whether controller is configured to have DMA handshaking interface.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HJCAP</name>
              <description>Reflects the IC_SLV_HJ Configurable Parameter Specifies slave's capability to initiate Hot-join request.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLVIBI</name>
              <description>Reflects the IC_SLV_IBI Configurable Parameter Specifies slave's capability to initiate slave interrupt requests.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GRPACAP</name>
              <description>Specifies the Target's capability to support Group Address.\n</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Group Address Disable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Group Address Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VIRTCAP</name>
              <description>Specifies the Target's capability to support Virtual Target.\n</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Is not a Virtual Target and does not expose other downstream Device(s)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Is a Virtual Target, or exposes other downstream Device(s)</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HDRBTEN</name>
              <description>Reflects the IC_SPEED_HDR_BT Configurable Parameter.Specifies the Controllers capability to perform HDR-BT transfers.\n</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>HDR-BT not supported</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>HDR-BT supported</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_CMDQUE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_CMDQUE</displayName>
          <description>I3C Command Queue Port Register</description>
          <addressOffset>0xC</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDQUE</name>
              <description>Command Queue\nPlease refer to chapter Master Command Data Structure and chapter Slave Command Data Structure</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_RESPQUE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_RESPQUE</displayName>
          <description>I3C Response Queue Port Register</description>
          <addressOffset>0x10</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RESPQUE</name>
              <description>Response Queue\nPlease refer to chapter Master Response Data Structure and chapter Slave Response Data Structure</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_TXRXDAT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_TXRXDAT</displayName>
          <description>I3C Transmit and Receive Data Port Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DAT</name>
              <description>Transmit and Receive Data Port\nTransmit (Write) Operation:\nThe Transmit Data port is mapped to the Tx-Data Buffer. The transmit data should always be packed as 4-byte aligned data words and written to the Transmit Data Port register. If the Command length is not aligned to 4-bytes, then the additional bytes are ignored.\nReceive (Read) Operation:\nThe Receive Data port is mapped to the Rx-Data Buffer. The Receive data is always packed in 4-byte aligned data words and stored in the Rx-Data Buffer. If the command length is not aligned to the 4-bytes, then the additional data bytes have to be ignored.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_IBIQUE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_IBIQUE</displayName>
          <description>I3C In-Band Interrupt Queue Data Register</description>
          <addressOffset>0x18</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IBIDAT</name>
              <description>In-Band Interrupt Data \nThis register is used in master mode of operation. \nThis register when read from, reads the data from the IBI Queue. This register is mapped to the IBI Queue.The IBI Data is always packed in 4-byte aligned and put to the IBI Queue. If the incoming data is not aligned to the 4-bytes, then there are unused bytes in the end location of the IBI transfer</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_QUETHCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_QUETHCTL</displayName>
          <description>I3C Queue Threshold Control Register</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-write</access>
          <resetValue>0x01000101</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDETH</name>
              <description>Command Buffer Empty Threshold Value\nControls the number of empty locations (or greater) in the Command Queue that trigger CMD_QUEUE_READY_STAT interrupt. The valid range is 0 to CMD_BUF_DEPTH-1. The software programs only valid values. Value of N ranging from 1 to CMD_BUF_DEPTH-1 sets the threshold to N empty locations and a value of 0 sets the threshold to indicate that the queue is completely empty.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RESPTH</name>
              <description>Response Buffer Threshold Value\nControls the number of entries (or greater) in the Response\nQueue that trigger the RESP_READY_STAT_INTR interrupt.\nThe valid range is 0 to RESP_DT-1. The software programs only valid values. A value of 0 sets the threshold for 1 entry, and a value of N sets the threshold for N+1 entries.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IBIDATTH</name>
              <description>IBI Data Threshold Value \nThis field represents the IBI data segment size in Dwords (4 bytes). The minimum supported segment size is 1 (4 bytes) and the maximum supported size is IC_IBI_DATA_BUF_DEPTH-1. The IBI_DATA_THLD field enables the slicing of the incoming IBI data and generate individual status and thereby promotes the cut-through operation in reading out the IBI data.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IBISTSTH</name>
              <description>In-Band Interrupt Status Threshold Value\nEvery In Band Interrupt received by I3C controller generates an IBI status. This field controls the number of IBI status entries (or greater) in the IBI queue that trigger the IBI_THLD_STAT interrupt. The valid range is 0 to IC_IBI_BUF_DEPTH-1. The software programs only valid values. A value of 0 sets the threshold for 1 entry, and a value of N sets the threshold for N+1 entries. \n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_DBTHCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_DBTHCTL</displayName>
          <description>I3C Data Buffer Threshold Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x01010101</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXTH</name>
              <description>Transmit Buffer Threshold Value\nThe supported values for TXTH are\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>1</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>4</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>8</description>
                    <value>#010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>16</description>
                    <value>#011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>32</description>
                    <value>#100</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXTH</name>
              <description>Receive Buffer Threshold Value\nThe supported values for RXTH are\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>1</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>4</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>8</description>
                    <value>#010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>16</description>
                    <value>#011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>32</description>
                    <value>#100</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXSTATH</name>
              <description>Transfer Start Threshold Value \nIn master mode of operation when the controller is set up to initiate a write transfer, it waits until either one of the following conditions are met before it initiates the write transfer on the I3C Interface.\nIn slave mode of operation the slave controller ACK's a read request from Master only if either one of the following conditions are met:\n1. Data length (as specified in the command) number of locations are filled in the Transmit FIFO\n2. Threshold number of entries (or more) are available in the Transmit FIFO\nThe supported values for RXSTATH are:\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>1</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>4</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>8</description>
                    <value>#010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>16</description>
                    <value>#011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>32</description>
                    <value>#100</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXSTATH</name>
              <description>Receive Start Threshold Value \nIn master mode of operation when the controller is set up to initiate a read transfer, it waits until either one of the conditions are met before it initiates the read transfer on the I3C Interface.\nIn the slave mode of operation the slave controller ACK's a write request from Master only if threshold number of empty locations(or more) are available in its receive buffer.\nThe supported values for RXSTATH are:\n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>1</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>4</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>8</description>
                    <value>#010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>16</description>
                    <value>#011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>32</description>
                    <value>#100</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_IBIQCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_IBIQCTL</displayName>
          <description>I3C IBI Queue Control Register</description>
          <addressOffset>0x24</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HJREJ</name>
              <description>Notify Rejected Master Request Control \nThis bit is used to suppress reporting to the application about Master request rejected. \n0x0 : Notify Master Request Rejected Disable \n0x1 : Notify Master Request Rejected Enable\nNote: This register is only used in master mode of operation</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MRREJ</name>
              <description>Notify Rejected Master Request Control.\nThis bit is used to suppress reporting to the application about Master request rejected.\n 0x0 : Notify Master Request Rejected Disable\n 0x1 : Notify Master Request Rejected Enable \nNote: This register is only used in master mode of operation</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SIRREJ</name>
              <description>Notify Rejected Slave Interrupt Request Control \nThis bit is used to suppress reporting to the application about SIR request rejected. \n0x0 : Notify SIR Rejected Disable \n0x1 : Notify SIR Rejected Enable\nNote: This register is only used in master mode of operation</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_RSTCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_RSTCTL</displayName>
          <description>I3C Reset Control Register</description>
          <addressOffset>0x34</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SWRST</name>
              <description>Core Software Reset\nWrite 1'b1 to this bit to exercise software reset. This resets all Buffers - Receive, Transmit, Command, and Response\nThis bit is cleared automatically once the core reset is complete.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CMDRST</name>
              <description>Command Queue Software Reset\nWrite 1'b1 to this bit to exercise Command Queue reset. This bit is cleared automatically once the Command Queue reset is complete.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RESPRST</name>
              <description>Response Queue Software Reset\nWrite 1'b1 to this bit to exercise Response Queue reset. This bit is cleared automatically once the Response Queue reset is complete.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXRST</name>
              <description>Transmit Buffer Software Reset\nWrite 1'b1 to this bit to exercise Transmit Buffer reset. This bit is cleared automatically once the Transmit Buffer reset is completed.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXRST</name>
              <description>Receive Buffer Software Reset\nWrite 1'b1 to this bit to exercise Receive Buffer reset. This bit is cleared automatically once the Receive buffer reset is\ncompleted.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBIQRST</name>
              <description>IBI Queue Software Reset \nThis bit is only used in master mode of operation. Write 1'b1 to this bit to exercise IBI Queue reset This bit is cleared automatically once the IBI Queue reset is completed</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSRSTPY</name>
              <description>Bus Reset type \nType of bus reset triggered by BUSRST. \n</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSRST</name>
              <description>Bus Reset \nThis bit is only used in master mode of operation. Write 1'b1 to this bit to exercise Bus Reset Reset Pattern Generation based on Bus Reset Type selection. This bit is cleared automatically once the Bus Reset Pattern Generation is completed.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVEVNTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVEVNTS</displayName>
          <description>I3C Slave Event Status Register</description>
          <addressOffset>0x38</addressOffset>
          <access>read-write</access>
          <resetValue>0x0000000B</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SIREN</name>
              <description>Slave Interrupt Request Enable\nIn Slave mode of operation, this bit reflects whether the controller can initiate the SIR on the I3C bus or not. Usually, this bit is set or cleared by the I3C Master through ENEC or DISEC CCC.\nNote: This bit is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MREN</name>
              <description>Master Request Enable.\nIn Slave mode of operation, this bit reflects whether the controller can initiate the Master Request on the I3C bus or not.Usually, this bit is set or cleared by the I3C Master throughENEC or DISEC CCC.\nNote: This bit is read only.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HJEN</name>
              <description>Hot-Join Interrupt Enable\nThis bit reflects whether the Hot-Join Request Interrupts are allowed on the I3C bus or not. The Slave application can choose to Disable HJ Capability of the SLave Controller (if selected) by setting this field to 0 before 'Enabling' the Controller. When done so, the Slave does not initiate Hot Join and takes part in Address Assignment without initiating Hot Join. If this field is NOT set to 0 by slave application, it can be set or cleared by the I3C Master through ENEC or DISEC CCCs. Once Disabled by software, CCCs do not have any effect on this field.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACTSTATE</name>
              <description>Activity State Status\nENTAS0 - 00\nENTAS1 - 01\nENTAS2 - 10\nENTAS3 - 11\nThis bit reflects the Activity State of slave set by the Master.\nNote: This field is read only.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>MRLUPD</name>
              <description>MRL Updated Status\nThis bit indicates a SETMRL CCC is received by the slave. The updated MRL value can be read from SLV_MAX_LEN register. This status can be cleared by writing 1'b1 to this field after reading the updated MRL.\nNote: This bit is cleared by writing 1 to it.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MWLUPD</name>
              <description>MWL Updated Status\nThis bit indicates a SETMWL CCC is received by the slave. The updated MWL value can be read from SLV_MAX_LEN register. This status can be cleared by writing 1'b1 to this field after reading the updated MWL.\nNote: This bit is cleared by writing 1 to it.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_INTSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_INTSTS</displayName>
          <description>I3C Interrupt Status Register</description>
          <addressOffset>0x3C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXTH</name>
              <description>Transmit Buffer Threshold Status\nThis interrupt is generated when the number of empty locations in transmit buffer is greater than or equal to threshold value specified by TXBUF_TD field in I3C_DBTHCTL register. This interrupt is cleared automatically when number of empty locations in transmit buffer is less than threshold value specified.\nNote: This bit is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXTH</name>
              <description>Receive Buffer Threshold Status\nThis interrupt is generated when number of entries in receive buffer is greater than or equal to threshold value specified by RXBUF_TD field in I3C_DBTHCTL register. This interrupt is cleared automatically when number of entries in receive buffer is less than threshold value specified.\nNote: This bit is read only.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBITH</name>
              <description>IBI Buffer Threshold Status \nThis field is only used in master mode of operation This interrupt is generated when number of entries in IBI buffer is greater than or equal to threshold value specified by IBISTTH field in I3C_QUETHCTL register. This interrupt is cleared automatically when number of entries in IBI buffer is less than threshold value specified.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CMDRDY</name>
              <description>Command Queue Ready Status\nThis interrupt is generated when number of empty locations in command queue is greater than or equal to threshold value specified by CMDEY_ TD field in QUETHCTL register. This interrupt is cleared automatically when number of empty locations in command buffer is less than threshold value specified.\nNote: This bit is read only.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RESPRDY</name>
              <description>Response Queue Ready Status\nThis interrupt is generated when number of entries in response queue is greater than or equal to threshold value\nspecified by RESPB_TD field in QUETHCTL register. This interrupt is cleared automatically when number of entries in response buffer is less than threshold value specified.\nNote: This bit is read only.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TFRABORT</name>
              <description>Transfer Abort Status. \nThis field is used only in master mode of operation. This interrupt is generated if transfer is aborted. This interrupt can be cleared by writing 1'b1.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CCCUPD</name>
              <description>CCC Table Updated Status\nThis field is used only in slave mode of operation. This interrupt is generated if any of the CCC registers are updated by I3C Master through CCC commands. This interrupt can be cleared by writing 1'b1.\nNote: This bit is cleared by writing 1 to it.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DAA</name>
              <description>Dynamic Address Assigned Status\nThis field is used only in slave mode of operation. This interrupt is generated if the device's Dynamic Address is assigned through SETDASA or ENTDAA CCC. This bit can be cleared by writing 1'b1.\nNote: This bit is cleared by writing 1 to it.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TFRERR</name>
              <description>Transfer Error Status\nThis interrupt is generated if any error occurs during transfer. The error type is specified in the response packet associated with the command (in ERR_STATUS field of RESPONSE_QUEUE_PORT register). This bit can be cleared by writing 1'b1.\nNote: This bit is cleared by writing 1 to it.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEFSLV</name>
              <description>Define Slave CCC Received Status\nThis interrupt is generated if DEFSLV CCC is received.This bit can be cleared by writing 1'b1.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>READREQ</name>
              <description>Read Request Received\nThis field is used only in slave mode of operation. Read Request received from the current master when CMDQ is empty. This bit can be cleared by writing 1'b1.\nNote: This bit is cleared by writing 1 to it.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBIUPD</name>
              <description>IBI Status Updated\nThis field is used only in slave mode of operation. It indicates that the IBI request initiated through SIR request register is addressed and status is updated.\nNote: This bit is cleared by writing 1 to it.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSOWNER</name>
              <description>Bus owner Updated Status\nThis interrupt is set when the role of the controller changes from being a Master to Slave or vice versa.\nThis bit can be cleared by writing 1'b1.\nNote: New bus ower value is updated in this only after RESUME.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSRSTDN</name>
              <description>Bus Reset Pattern Generation Done Status\nThis field is used only in Master mode of operation. This interrupt is generated when the SCL Low Timeout Bus Reset Pattern Generation is completed. This bit can be cleared by writing 1'b1.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STADET</name>
              <description>START Detection Interrupt.\nThis field indicates START detected in Target mode of operation. This interrupt is provided for the user/application (in CCR mode) to decide whether the NCR has taken over the ownership after the bus handover was completed successfully to move to Target mode. And to reset the reset action configured by the RSTACT CCC. This bit can be cleared by</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSTPTDET</name>
              <description>Target Reset Pattern Detection Interrupt.\nThis field is used only in Target mode of operation.\nThis interrupt is generated when the Target Reset pattern is\ndetected.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GRPADRA</name>
              <description>Group Address Assigned Status.\nThis field is used only in target mode of operation. This interrupt is generated if one of the device's Group Address is assigned through SETGRPA CCC or reset through RSTGRPA CCC. This bit can be cleared by writing 1'b1.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SDARES</name>
              <description>SDA Released from Stuck state Status.\nThis field is used only in target mode of operation.\nThis interrupt is generated if the SCL was not changed for the prescribed amount of time defined by RELEASE_SDA_TIMING register.\nThis bit can be cleared by writing 1'b1.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCMDSS</name>
              <description>EXT_CMD_REG_x has finished Status.\nThis field is used only in target mode of operation.\nThis interrupt is generated if Read Transfer has finished in the EXT_CMD_REG_x registers.\nThis interrupt is cleared automatically when register.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCMDTH</name>
              <description>EXT_CMD_REG_x Transmit Buffer Threshold Status.\nThis field is used only in target mode of operation.This status is set when the number of empty locations in any EXT_CMD_REG_x transmit buffer is greater than or equal to threshold value specified by CMD_TX_BUF_THLD field in EXT_TX_EMPTY_RX_RSP_THLD_CTRL register. This interrupt is cleared automatically when number of empty locations in all the EXT_CMD_REG_x transmit buffers is less than threshold value specified.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_INTSTSEN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_INTSTSEN</displayName>
          <description>I3C Interrupt Status Enable Register</description>
          <addressOffset>0x40</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXTH</name>
              <description>Transmit Buffer Threshold Status Enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXTH</name>
              <description>Receive Buffer Threshold Status Enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBITH</name>
              <description>IBI Buffer Threshold Status Enable</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CMDRDY</name>
              <description>Command Queue Ready Status Enable</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RESPRDY</name>
              <description>Response Queue Ready Status Enable</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TFRABORT</name>
              <description>Transfer Abort Status Enable \nThis field is used only in master mode of operation.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CCCUPD</name>
              <description>CCC Table Updated Status Enable\nThis field is used in slave mode of operation.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DAA</name>
              <description>Dynamic Address Assigned Status Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TFRERR</name>
              <description>Transfer Error Status Enable</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEFSLV</name>
              <description>Define Slave CCC Received Status Enable</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>READREQ</name>
              <description>Read Request Received Status Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBIUPD</name>
              <description>IBI Updated Status Enable\nThis field is used in slave mode of operation.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSOWNER</name>
              <description>Bus owner Updated Status Enable</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSRSTDN</name>
              <description>Bus Reset Pattern Generation Done Status Enable\nThis field is used only in Master mode of operation.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STADET</name>
              <description>START Detection Status Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSTPTDET</name>
              <description>Target Reset Pattern Detection Status Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GRPADRA</name>
              <description>Group Address Assigned Status Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SDARES</name>
              <description>SDA Released from Stuck state Status Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCMDSS</name>
              <description>EXT_CMD_REG_x has finished Status Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCMDTH</name>
              <description>EXT_CMD_REG_x Transmit Buffer Threshold Status Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_INTEN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_INTEN</displayName>
          <description>I3C Interrupt Signal Enable Register</description>
          <addressOffset>0x44</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXTH</name>
              <description>Transmit Buffer Threshold Signal Enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXTH</name>
              <description>Receive Buffer Threshold Signal Enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBITH</name>
              <description>IBI Buffer Threshold Signal Enable</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CMDRDY</name>
              <description>Command Queue Ready Signal Enable</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RESPRDY</name>
              <description>Response Queue Ready Signal Enable</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TFRABORT</name>
              <description>Transfer Abort Status Signal Enable \nThis field is used only in master mode of operation.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CCCUPD</name>
              <description>CCC Table Updated Signal Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DAA</name>
              <description>Dynamic Address Assigned Signal Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TFRERR</name>
              <description>Transfer Error Signal Enable</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEFSLV</name>
              <description>Define Slave CCC Received Status Enable</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>READREQ</name>
              <description>Read Request Received Signal Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBIUPD</name>
              <description>IBI Updated Signal Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSOWNER</name>
              <description>Bus owner Updated Status Enable</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSRSTDN</name>
              <description>Bus Reset Pattern Generation Done Signal Enable\nThis field is used only in Master mode of operation.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STADET</name>
              <description>START Detection Signal Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSTPTDET</name>
              <description>Target Reset Pattern Detection Signal Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GRPADRA</name>
              <description>Group Address Assigned Signal Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SDARES</name>
              <description>SDA Released from Stuck state Signal Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCMDSS</name>
              <description>EXT_CMD_REG_x has finished Signal Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCMDTH</name>
              <description>EXT_CMD_REG_x Transmit Buffer Threshold Signal Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_INTFORCE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_INTFORCE</displayName>
          <description>I3C Interrupt Force Enable Register</description>
          <addressOffset>0x48</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXTH</name>
              <description>Transmit Buffer Threshold Force Enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXTH</name>
              <description>Receive Buffer Threshold Force Enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBITH</name>
              <description>IBI Buffer Threshold Force Enable</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CMDRDY</name>
              <description>Command Queue Ready Force Enable</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RESPRDY</name>
              <description>Response Queue Ready Force Enable</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TFRABORT</name>
              <description>Transfer Abort Status Force Enable \nThis field is used only in master mode of operation.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CCCUPD</name>
              <description>CCC Table Updated Force Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DAADADR_AFE</name>
              <description>Dynamic Address Assigned Force Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TFRERR</name>
              <description>Transfer Error Force Enable</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DEFSLV</name>
              <description>Define Slave CCC Received Status Enable</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>READREQ</name>
              <description>Read Request Received Force Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBIUPD</name>
              <description>IBI Updated Force Enable \nThis field is used in slave mode of operation.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSOWNER</name>
              <description>Bus owner Updated Status Enable</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BUSRSTDN</name>
              <description>Bus Reset Pattern Generation Done Force Enable \nThis field is used only in Master mode of operation.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STADET</name>
              <description>START Detection Force Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RSTPTDET</name>
              <description>Target Reset Pattern Detection Interrupt Force Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>GRPADRA</name>
              <description>Group Address Assigned Force Enable.\nThis field is used only in Target mode of operation.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SDARES</name>
              <description>SDA Released from Stuck state Force Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCMDSS</name>
              <description>EXT_CMD_REG_x has finished Force Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EXCMDTH</name>
              <description>EXT_CMD_REG_x Transmit Buffer Threshold Force Enable.\nThis field is used in target mode of operation.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_QUESTSLV</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_QUESTSLV</displayName>
          <description>I3C Queue Status Level Register</description>
          <addressOffset>0x4C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000008</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDELOC</name>
              <description>Command Queue Empty Locations\nContains the number of empty locations in the command Buffer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RESPLV</name>
              <description>Response Buffer Level Value\nContains the number of valid data entries in the response Buffer.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IBIBLR</name>
              <description>IBI Buffer Level Value \nContains the number of valid IBI Data entries in the IBI Data Buffer. \nThis field is used in master mode of operation</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IBISCNT</name>
              <description>IBI Buffer Status Count\nContains the number of valid IBI Status entries in the IBI Status Buffer. \nThis field is used in master mode of operation.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_DBSTSLV</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_DBSTSLV</displayName>
          <description>I3C Data Buffer Status Level Register</description>
          <addressOffset>0x50</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000010</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXELV</name>
              <description>Transmit Buffer Empty Level Value\nContains the number of empty locations in the transmit Buffer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RXLV</name>
              <description>Receive Buffer Level Value\nContains the number of valid data entries in the receive Buffer.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_PRESENTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_PRESENTS</displayName>
          <description>I3C Present State Register</description>
          <addressOffset>0x54</addressOffset>
          <access>read-only</access>
          <resetValue>0x10000007</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SCLLEL</name>
              <description>This bit is used to check the SCL line level to recover from errors and for debugging \nThis bit reflects the value of synchronized scl input signal. \nThis is valid in Master mode only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SDALEL</name>
              <description>This bit is used to check the SDA line level to recover from errors and for debugging \nThis bit reflects the value of synchronized sda input signal. \nThis is valid in Master mode only.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CURMST</name>
              <description>This Bit is used to check whether the Master is Current Master or not. The Current Master is the Master that owns the SCL line.\nIf this bit is set to 0, the Master is not Current Master and requires to request and the ownership before initiating any transfer on the line.\nIf this bit is set to 1, the Master is the Current Master and can initiate the transfers on the line.\n</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Master is not Current Master</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Master is Current Master</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TFRTYPE</name>
              <description>Transfer Type Status \nIn Master mode of operation: \n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>CMTFRSTS</name>
              <description>Current Master Transfer State Status. Indicates the state of current transfer currently executing by the I3C controller. This is valid in Master mode only. \n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>TID</name>
              <description>Transmit Transaction ID \nThis field reflects the Transaction ID of the current executing command.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CONIDLE</name>
              <description>This field reflects whether the Controller Mode is in Idle state or not \nThis bit is set when all the Queues(Command , Response, IBI) and Buffers(Transmit and Receive) are empty along with the Controller State machine is in Idle state. \n</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Controller is not in IDLE State</description>
                    <value>0x0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Controller is in IDLE State</description>
                    <value>0x1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_CCCDEVS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_CCCDEVS</displayName>
          <description>I3C Device Operating Status Register</description>
          <addressOffset>0x58</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PENDINT</name>
              <description>Pending Interrupt \nThis field reflects the value driven on pending_int input port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PROTERR</name>
              <description>Protocol Error \nThis bit is set when the slave controller encouters a Parity/CRC error during write data transfer.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ACTMODE</name>
              <description>Activity Mode \nThis field reflects the input port signal act_mode.MIPI: Contains the two-bit ID of the Slave Device's current Activity Mode \n(readiness to support data read of sensor or related information).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>UDFERR</name>
              <description>Underflow Error \nUnder Flow Error during private master read transfer. This bit is set if slave controller terminates a read transfer because of unavailability of data in the transmit buffer. This is cleared only after master reads the Device Status through GETSTATUS CCC.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLVBUSY</name>
              <description>Slave Busy \nThis bit is set if any change is made by the current master in to MRL register or occurance of any error. It is cleared after slave application resumes the slave operation by writing 1'b1 in RESUME field of Device Control Register.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>OVFERR</name>
              <description>Overflow Error \nOverflow error condition detected during master write transfer. This is cleared only after master reads the Device Status through GETSTATUS CCC.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DATNRDY</name>
              <description>Data Not Ready \nThis bit is set when private read request from Master is NACKED because of any of the following conditions \n1. Command FIFO Empty. \n2. Transmit FIFO threshold is not met. \n3. Response FIFO Full. This is cleared when the Master issues GET_STATUS CCC or upon successful completion of the subsequent read transfer.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BFNAVAIL</name>
              <description>Buffer Not Available\nThis bit is set when private write request from Master is NACKED because of RX buffer not having RX_BUF_THLD number of empty locations or Response buffer is full. In SDR mode of operation this is cleared when the Master issues GET_STATUS CCC or upon space becoming available in the buffer and the successful completion of the next write transfer. In HDR mode of operation it is cleared only when Master issues GET_STATUS CCC</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FRAMEERR</name>
              <description>Frame Error \nThis bit is set when private write request from Master has frame error in HDR-DDR/HDR-TSP/TSL mode. This is cleared only after Master reads the device status through GETSTATUS_CCC.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_ADDRTP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_ADDRTP</displayName>
          <description>I3C Pointer for Device Address Table Register</description>
          <addressOffset>0x5C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00070280</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>STARTADDR</name>
              <description>Start Address of Device Address Table.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>TABLEDEPTH</name>
              <description>Depth of Device Address Table</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_CHRTP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_CHRTP</displayName>
          <description>I3C Pointer for Device Characteristics Table Register</description>
          <addressOffset>0x60</addressOffset>
          <access>read-only</access>
          <resetValue>0x0001C200</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CHARSTART</name>
              <description>Start Address of Device Characteristics Table.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>CHARDEPTH</name>
              <description>Depth of Device Characteristics Table</description>
              <bitOffset>12</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>CHARINDEX</name>
              <description>Current index of Device Characteristics Table This field returns the current location of Device Characteristics Table index Initially, this index points to 0. Once the complete characteristics information of a Slave device is written into Device Characteristics Table during ENTDAA, this index increments by 1. The first winning device information is stored in Device Characteristics Table index 0, the</description>
              <bitOffset>19</bitOffset>
              <bitWidth>13</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_VENDOR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_VENDOR</displayName>
          <description>I3C Start Address of Vendor specific Register</description>
          <addressOffset>0x6C</addressOffset>
          <access>read-only</access>
          <resetValue>0x000000B0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VENODRADDR</name>
              <description>Pointer for Vendor specific Registers</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVMID</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVMID</displayName>
          <description>I3C MIPI Manufacturer ID Register</description>
          <addressOffset>0x70</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PIDTYPE</name>
              <description>Specifies the Provisional ID Type Selector</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MID</name>
              <description>Specifies the MIPI Manufacturer ID</description>
              <bitOffset>1</bitOffset>
              <bitWidth>15</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVPID</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVPID</displayName>
          <description>I3C Normal Provisional ID Register</description>
          <addressOffset>0x74</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DCR</name>
              <description>Specifies the additional 12-bit ID of DWC_mipi_i3c device</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>INSTID</name>
              <description>This field is used to program the instance ID of the Slave The reset value of this register is taken from input port 'inst_id'.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PARTID</name>
              <description>Specifies the Part ID of DWC_mipi_i3c device</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVCHAR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVCHAR</displayName>
          <description>I3C Slave Characteristic Register</description>
          <addressOffset>0x78</addressOffset>
          <access>read-write</access>
          <resetValue>0x00010076</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MXDSLIM</name>
              <description>Max Data Speed Limitation field in Bus Characteristic Register \n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No limitation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Limitation</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IBICAP</name>
              <description>IBI Request Capable field in Bus Characteristic Register \nNote: This bit is read only.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Support IBI</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IBIPL</name>
              <description>IBI Payload field in Bus Characteristic Register \nNote: This bit is read only.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Support IBI payload</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OLCAP</name>
              <description>Offline Capable field in Bus Characteristic Register \nNote: This bit is read only.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Slave will always respond to I3C bus commands</description>
                    <value>#0</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRIDGEID</name>
              <description>Bridge Identifier field in Bus Characteristic Register \nNote: This bit is read only.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Not a bridge device</description>
                    <value>#0</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HDRCAP</name>
              <description>SDR Only or SDR and HDR Capable field in Bus Characteristic Register \n</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>SDR only. It doesn't disable the HW HDR feature, it just doesn't advertise the Slave HDR capability to Master</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>HDR capable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DEVROLE</name>
              <description>Device Role field in Bus Characteristic Register \nNote: This bit is read only.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DCR</name>
              <description>I3C Device Characteristic Value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>HDRCPVAL</name>
              <description>I3C Device HDR Capability Register Value\nNote: This bit is read only.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>1</name>
                    <description>HDR-DDR</description>
                    <value>1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVMXLEN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVMXLEN</displayName>
          <description>I3C Maximum Write/Read Length Register</description>
          <addressOffset>0x7C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00FF00FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MWL</name>
              <description>I3C Device Max Write Length\n(Can be updated if SETMWL CCC is received)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>MRL</name>
              <description>I3C Device Max Read Length\n(Can be updated if SETMRL CCC is received)</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_MXRDTURN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_MXRDTURN</displayName>
          <description>I3C Maximum Read Turnaround Time Register</description>
          <addressOffset>0x80</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MXRDTURN</name>
              <description>Specifies the maximum read turnaround time \n(The 3rd byte which returned in the GETMXDS CCC)\nNote: This field is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_MXDS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_MXDS</displayName>
          <description>I3C Maximum Data Speed Register</description>
          <addressOffset>0x84</addressOffset>
          <access>read-write</access>
          <resetValue>0x00080008</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MXWR</name>
              <description>Specifies the Maximum Sustained Data Rate for non-CCC messages sent by Master Device to Slave device  \n(The 1st byte which returned in the GETMXDS CCC)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>12.5 MHz</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>8 MHz</description>
                    <value>1</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>6 MHz</description>
                    <value>2</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>4 MHz</description>
                    <value>3</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>2 MHz</description>
                    <value>4</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MXDSDEFB</name>
              <description>Specifies the defining byte support of GETMXDS CCC\n</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Doesn't support defining byte</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>supports defining byte</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MXRD</name>
              <description>Specifies the Maximum Sustained Data Rate for non-CCC messages sent by Slave Device to Master Device  \n(The 2nd byte which returned in the GETMXDS CCC)</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>12.5 MHz</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>8 MHz</description>
                    <value>1</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>6 MHz</description>
                    <value>2</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>4 MHz</description>
                    <value>3</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>2 MHz</description>
                    <value>4</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MXDTURN</name>
              <description>Specifies the clock to data turnaround time \n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>8 ns</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>9 ns</description>
                    <value>1</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>10 ns</description>
                    <value>2</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>11 ns</description>
                    <value>3</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>12 ns</description>
                    <value>4</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MXDSTOP</name>
              <description>Specifies the stop support between write and read\n</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Stop will cancel the read</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The target permits the write to read to be split by a stop</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MXDSACT</name>
              <description>This 2-bit integer indicates whether this I3C Device initially acts with a given Activity State, after becoming Active Controller on the Bus according to the Controller handoff flow.\n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Acts according to Activity State 0</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Acts according to Activity State 1</description>
                    <value>1</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Acts according to Activity State 2</description>
                    <value>2</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Acts according to Activity State 3</description>
                    <value>3</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MXDSTACT</name>
              <description>This bit indicates whether the Active Controller should set the Bus to the Activity State indicated in bits 25:24 before handing the Controller Role off to this I3C Device as part of the normal flow.\n</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The Active Controller should not set the Bus to any Activity State before handoff to this Device</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The Active Controller should set the Bus to the Activity State indicated by bits 25:24 before handoff to this Device</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SIR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SIR</displayName>
          <description>I3C Slave Interrupt Request Register</description>
          <addressOffset>0x8C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EN</name>
              <description>Slave Interrupt Request\nWhen set, the slave controller attempts to issue the SIR on the I3C bus based on CTL field. If CTL is set to 2'b00, Target controller clears this bit automatically and update the IBISTS field upon either current controller accepts through generating (ACK) OR If Target controller is unable to issue the SIR.If CTL is set to 2'b00, Target controller reattempts the SIR either upon detecting the next START condition from the controller OR after the Bus Available Time If NACK response is received for the SIR. If CTL is set to 2'b01, Target controller clears this bit automatically after sampling the SCL Low (pulled by Controller) for the generated SDA low. Target will release the SDA line upon sampling the SCL low. This feature is used in CE3 error recovery flow. Once set, the software cannot clear this bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CTL</name>
              <description>Slave Interrupt Request Control\n</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>MR</name>
              <description>Master Request\nWhen set, the controller attempts to issue the MR on the I3C bus. Once issued and when the current master accepts(ACK) or if the controller is unable to issue the MR, then the controller clears this bit automatically and updates the IBI_STS field. If NACK response is received for the MR, the controller reattempts the MR upon detecting the next START condition from the master or after the Bus Available time. This bit is available only in the secondary master configuration. For other configurations, this bit is reserved and returns 0 when read. Once set, the application cannot clear this bit.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TS</name>
              <description>Support for Asynchronous Time Stamp\n(Mode-0). Enabling this bit will allow the Target to capture the\nTime-Stamp from external input signal 'async0_ts_cntr' duringT_C1 and T_C2 markers and append it along with the Payload data.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CE3REY</name>
              <description>Recovery from CE3 error.\nWhen the conditions for entering CE3 error are, the user will program this bit for recovering from CE3 error. Upon receiving this bit, the target will move to controller mode and generate a START and continue in generating 7E followed by STOP. This bit is auto cleared by the controller after the completion of recovery and moved to controller mode.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MDB</name>
              <description>Mandatory Data Byte \nThis field gives the mandatory data byte which is required to be transmitted after the Master ACK the slave address during SIR transfer. This field is only applicable when BCR[2] is set indicating that SIR supports payload data.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DATLEN</name>
              <description>Slave Interrupt Request Data Length \nThis field should be programmed by the slave application to give the data length for the payload data other than the MDB byte. This field is only applicable when BCR[2] is set indicating that SIR supports payload data.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>TGTINX</name>
              <description>SIR Target Index\nThis field should be programmed by the Target application to select from what Virtual Target the SIR is sent.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SIRDAT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SIRDAT</displayName>
          <description>I3C Slave Interrupt Request Data Register</description>
          <addressOffset>0x94</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DAT0</name>
              <description>SIR Data Byte 0 \nThis register SIRDATA containing four bytes of SIR Data will be in effect only when SIR_CTRL field in INTRREQ is programmed to 00 provided the data length is up to 1. \nThis field holds the first byte of SIR DATA that will be passed after the MDB when SIR is initiated by the application on writing into SIR bit in INTRREQ Register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DAT1</name>
              <description>SIR Data Byte 1 \nThis register SIRDATA containing four bytes of SIR Data will be in effect only when SIR_CTRL field in INTRREQ is programmed to 00 provided the data length is up to 2. \nThis field holds the second byte of SIR DATA that will be passed after the MDB when SIR is initiated by the application on writing into SIR bit in INTRREQ Register.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DAT2</name>
              <description>SIR Data Byte 2 \nThis register SIRDATA containing four bytes of SIR Data will be in effect only when SIR_CTRL field in INTRREQ is programmed to 00 provided the data length is up to 3. \nThis field holds the third byte of SIR DATA that will be passed after the MDB when SIR is initiated by the application on writing into SIR bit in INTRREQ Register.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DAT3</name>
              <description>SIR Data Byte 3 \nThis register SIRDATA containing four bytes of SIR Data will be in effect only when SIR_CTRL field in INTRREQ is programmed to 00 provided the data length is up to 4. \nThis field holds the fourth byte of SIR DATA that will be passed after the MDB when SIR is initiated by the application on writing into SIR bit in INTRREQ Register.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SIRRESP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SIRRESP</displayName>
          <description>I3C Slave Interrupt Request Response Register</description>
          <addressOffset>0x98</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IBISTS</name>
              <description>IBI Completion Status \nThis field is common for SIR and MR \nThe controller does not attempt to issue the IBI and generates the IBI Completion Status as 3'b011 if one of the following condition is true. \n1. Master has not assigned the Dynamic Address. \n2. Master has cleared the assigned Dynamic Address (through RSTDAA CCC). \n3. Master has disabled the IBI event (through DISEC CCC). \n4. The controller has switched the role to Master (applicable only for secondary master configuration). \n5. DL doesn't match with SIR_CTRL.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Reserved</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>IBI accepted by the Master (ACK response received)</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Master Early Terminate (only for SIR with Data)</description>
                    <value>#010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>IBI Not Attempted</description>
                    <value>#011</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATLEN</name>
              <description>Data Length for SIR Response \nThe value in this filed will indicate the number of bytes remaining that was not transmitted because of Master early terminating the SIR transfer. \nIn case the IBI is not attempted the number for bytes returned will be same as that programmed for IBI payload</description>
              <bitOffset>8</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_NACKREQ</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_NACKREQ</displayName>
          <description>I3C Slave NACK Request Register</description>
          <addressOffset>0x9C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>NAKREQ</name>
              <description>Application request to NACK the next new transfer\nA value of 2'b01 should be written in this field to make controller initiate NACK for incoming transfer. A value of 2'b00 written on this field will cancel NACK request from application</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_NACKCON</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_NACKCON</displayName>
          <description>I3C Slave NACK Confirm Register</description>
          <addressOffset>0xA0</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>NAKCON</name>
              <description>This field indicates the status of the controller for NACK request made by the applications. \n2'b00: Indicates the controller is not in NACK state. A value of 2'b00 in this field after the application has written 2'b01 in NACK_REQ field of SLV_NACK_REQ register will indicate the NACK request is not accepted by the controller. In this case the application must be prepared to receive a private or a CCC transfer that has been targeted to this slave. 2'b01- Indicates the NACK request from the application is accepted and the controller will NACK all transfers targeted to this slave. 2'b11- Indicates the controller is busy and the NACK request from the application is still not accepted. The application needs to wait until this status shows the value of 2'b01 or 2'b00 to indicate acceptance of NACK request or un-acceptance of NACK request.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_INSTSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_INSTSTS</displayName>
          <description>I3C Slave Instant Status Register</description>
          <addressOffset>0xA4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>INTSTS</name>
              <description>Indicates Internal status of the controller. \nThese bits indicates the internal status of the controller. \n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>CCCONG</name>
              <description>Indicates a CCC transfer is on-going.\nThis bit ccc_ongoing is asserted after 7e header the first bit of CCC is received and it is de-asserted either when a STOP or a 7e with a re-start comes on the I3C line. This bit is synchronized from SCL domain to core clock domain hence will have some synchronization latency associated with it.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WRONG</name>
              <description>Indicates a write transfer is on-going. \nThis bit is asserted whenever there is an address match for the Master Write transfer targeted for this slave. This signal remains asserted until the write transfer is over from the Master. This bit is synchronized from SCL domain to core clock domain hence will have some synchronization latency associated with it.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WAKEUP</name>
              <description>Indicates the slave is addressed and the application is required to be ready. \nThis bit is asserted when an address match occurs indicating the Master is trying to access this slave. This bit is de-asserted after an address mismatch or on STOP. It is also de-asserted after a re-start followed by 7E. This bit is synchronized from SCL domain to core clock domain hence will have some synchronization latency associated with it.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_DEVCTLE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_DEVCTLE</displayName>
          <description>I3C Device Control Extended Register</description>
          <addressOffset>0xB0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>OPERMODE</name>
              <description>This bit is used to select the Device Operation Mode before the controller is enabled. \nThis field is automatically updated by the controller once the role change happens in secondary master mode.\n 0: Master \n 1: Slave \n 2: Reserved \n 3: Reserved\nNote :This field is written only when the i3c is disabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>MRACKCTL</name>
              <description>In Slave mode of operation, this bit serves as a control to ACK/NACK GETACCMST CCC from current master.\n 0: ACK GETACCMST CCC\n 1: NACK GETACCMST CCC</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLOD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLOD</displayName>
          <description>SCL I3C Open Drain Timing Register</description>
          <addressOffset>0xB4</addressOffset>
          <access>read-write</access>
          <resetValue>0x003F007F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ODLCNT</name>
              <description>I3C Open Drain Low Count \nSCL Open-drain low count for I3C transfers targeted to I3C devices.\nNote: ODLCNT value can not be zero</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ODHCNT</name>
              <description>I3C Open Drain High Count \nSCL open-drain High count for I3C transfers targeted to I3C devices.\nNote: ODHCNT value can not be zero</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLPP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLPP</displayName>
          <description>SCL I3C Push Pull Timing Register</description>
          <addressOffset>0xB8</addressOffset>
          <access>read-write</access>
          <resetValue>0x000A000A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PPLCNT</name>
              <description>I3C Push Pull Low Count \nSCL Push-Pull low count for I3C transfers targeted to I3C devices.\nNote: PPLCNT value can not be zero</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PPHCNT</name>
              <description>I3C Push Pull High Count \nSCL Push-Pull High count for I3C transfers targeted to I3C devices.\nNote: PPHCNT value can not be zero</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLFM</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLFM</displayName>
          <description>SCL I2C Fast Mode Timing Register</description>
          <addressOffset>0xBC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00FF00FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FMLCNT</name>
              <description>I2C Fast Mode Low Count \nThe SCL open-drain low count timing for I2C fast mode transfers.\nNote: FMLCNT value can not be zero</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>FMHCNT</name>
              <description>I2C Fast Mode High Count \nThe SCL open-drain high count timing for I2C fast mode transfers.\nNote: FMHCNT value can not be zero</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLFMP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLFMP</displayName>
          <description>SCL I2C Fast Mode Plus Timing Register</description>
          <addressOffset>0xC0</addressOffset>
          <access>read-write</access>
          <resetValue>0x007F007F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FMPLCNT</name>
              <description>I2C Fast Mode Low Count \nThe SCL open-drain low count timing for I2C fast mode transfers.\nNote: FMPLCNT value can not be zero</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>FMPHCNT</name>
              <description>I2C Fast Mode High Count \nThe SCL open-drain high count timing for I2C fast mode transfers.\nNote: FMPHCNT value can not be zero</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLEXTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLEXTL</displayName>
          <description>I3C SCL Extended Low Count Timing Register</description>
          <addressOffset>0xC8</addressOffset>
          <access>read-write</access>
          <resetValue>0x20202020</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXLCNT1</name>
              <description>I3C Extended Low Count Register 1\nSDR1 uses this register field for data transfer</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>EXLCNT2</name>
              <description>I3C Extended Low Count Register 2\nSDR2 uses this register field for data transfer</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>EXLCNT3</name>
              <description>I3C Extended Low Count Register 3\nSDR3 uses this register field for data transfer</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>EXLCNT4</name>
              <description>I3C Extended Low Count Register 4\nSDR4 uses this register field for data transfer</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLTERM</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLTERM</displayName>
          <description>I3C SCL Termination Bit Low count Timing Register</description>
          <addressOffset>0xCC</addressOffset>
          <access>read-write</access>
          <resetValue>0x10000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTERM</name>
              <description>I3C Read Termination Bit Low count.\nExtended I3C Read Termination Bit low count for I3C Readtransfers. Effective Termination-Bit Low Period is derived based on the SDR speed as shown below SDR0 speed: PPLCNT + EXTERM\nSDR1 speed: EXLCNT1 + EXTERM\nSDR2 speed: EXLCNT2 + EXTERM\nSDR3 speed: EXLCNT3 + EXTERM\nSDR4 speed: EXLCNT4 + EXTERM</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>STOPHLD</name>
              <description>STOP HOLD Count\nStop Hold Count in terms of ECLK which is used for generation of Stop Hold generation in Controller Mode.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SDAHOLD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SDAHOLD</displayName>
          <description>SDA Hold and Mode Switch Delay Timing Register</description>
          <addressOffset>0xD0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SDAOPDLY</name>
              <description>This field is used to delay the sda_oe with respect to sda_out while switching the transfer from OD1\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>SDAPDDLY</name>
              <description>This field is used to delay the sda_out with respect to sda_oe \n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>TXHOLD</name>
              <description>This field controls the hold time \n(in term of the core clock period) of the transmit data (SDA) with respect to the SCL edge in FM FM+ SDR and DDR speed mode of operations.\n The valid values are 1 to 7. Others are Reserved.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_BUSFAT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_BUSFAT</displayName>
          <description>I3C Bus Free and Available Timing Register</description>
          <addressOffset>0xD4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00500050</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FREETC</name>
              <description>This register field is used only in Master mode of operation I3C Bus Free Count Value. In Pure Bus System, this field represents tCAS parameter. In Mixed Bus system, this field is expected to be programmed to tLOW of I2C Timing</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>AVAILTC</name>
              <description>Bus Avaliable Time Count Value\nThis register field is used only in Slave mode of operation Bus Available Count Value . This field is used by the Slave to initiate an IBI after STOP condition.\n(for IBI)</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_BUSIDLET</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_BUSIDLET</displayName>
          <description>I3C Bus Idle Timing Register</description>
          <addressOffset>0xD8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000050</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IDLETC</name>
              <description>Bus Idle Time Count Value\nThis field is used by the controller in Slave mode to initiate Hot-Join request if the dynamic address is not valid.\n(for Hot-Join)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLLOW</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLLOW</displayName>
          <description>SCL Low Timeout register</description>
          <addressOffset>0xDC</addressOffset>
          <access>read-write</access>
          <resetValue>0x003567E0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LOWTIMER</name>
              <description>This count defines the number of core clock periods to count for generation of the SCL Low Bus Reset Pattern.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>26</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_VERID</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_VERID</displayName>
          <description>I3C Version ID Register</description>
          <addressOffset>0xE0</addressOffset>
          <access>read-only</access>
          <resetValue>0x3130312A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VERID</name>
              <description>Current Release Number\nThis field indicates the mipi_i3c current release number that is read by an application. For example, release number &quot;1.00a&quot; is represented in ASCII as 0x313030. Lower 8 bits read from this register can be ignored by the application. An application reading this register along with the I3C_VER_TYPE register, gathers details of the current release.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_VERTYPE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_VERTYPE</displayName>
          <description>I3C Version Type Register</description>
          <addressOffset>0xE4</addressOffset>
          <access>read-only</access>
          <resetValue>0x6C633030</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VERTYPE</name>
              <description>Current Release Type\nThis field indicates the mipi_i3c current release type that is read by an application. For example, release type &quot;ga&quot; is represented in ASCII as 0x6761 and &quot;ea&quot; is represented as 0x6561. Lower 16 bits read from this register can be ignored by the application if release type is &quot;ga&quot;. If release type is &quot;ea&quot; the lower 16 bits represents the &quot;ea&quot; release version. An application reading this register along with the IVERID register, gathers details of the current release.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_QUESIZE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_QUESIZE</displayName>
          <description>I3C Queue And Data Buffer Size Capability Register</description>
          <addressOffset>0xE8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00311243</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXSIZE</name>
              <description>Transmit Data Buffer Size \nThis field reflects the configured Transmit Buffer size (in DWORDS) in Encoded Values. Values:\nNote: This field is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>2 DWORDS1 = 4 DWORDS2 = 8 DWORDS3 = 16 DWORDS (supported in NUC1263)4 = 32 DWORDS5 = 64 DWORDS</description>
                    <value>0</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXSIZE</name>
              <description>Receive Data Buffer Size \nThis field reflects the configured Receive Buffer size (in DWORDS) in Encoded Values.\nNote: This field is read only.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CMDSIZE</name>
              <description>Command Queue Size \nNote: This field is read only.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RESPSIZE</name>
              <description>Response Queue Size \nThis field reflects the configured Response Queue size (in DWORDS) in Encoded Values. Values:\nNote: This field is read only.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>2 DWORDS (supported in NUC1263)1 = 4 DWORDS2 = 8 DWORDS3 = 16 DWORDS</description>
                    <value>0</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IBIFSIZE</name>
              <description>Response Queue Size\nThis field reflects the configured Response Queue size (in DWORDS) in Encoded Values.Values:\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>2 DWORDS</description>
                    <value>0x0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>4 DWORDS</description>
                    <value>0x1</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>8 DWORDS</description>
                    <value>0x2</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>16 DWORDS</description>
                    <value>0x3</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXTXSIZE</name>
              <description>Extended TX Buffer Size\nThis field reflects the configured Extended TX Buffer size (in DWORDS) in Encoded Values.Values:\n</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>2 DWORDS</description>
                    <value>0x0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>4 DWORDS</description>
                    <value>0x1</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>8 DWORDS</description>
                    <value>0x2</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>16 DWORDS</description>
                    <value>0x3</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_RELESDA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_RELESDA</displayName>
          <description>Release SDA Timing Register</description>
          <addressOffset>0xEC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00004E20</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RELETIME</name>
              <description>Release SDA count value.\nThis field is used in the target mode of operation to release the SDA line if SCL is not changing for a prescribed amount of time programmed in this register (RELETIME * (in\nterms of the core clock))</description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_HDRFLOW</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_HDRFLOW</displayName>
          <description>I3C Target HDR Flow Control Register</description>
          <addressOffset>0xF0</addressOffset>
          <access>read-write</access>
          <resetValue>0x000000F0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DDRWACK</name>
              <description>This field indicates the capability of Target to ACK/NACK DDR write command. \n</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DDREARLY</name>
              <description>This field indicates the capability of Target for WRITE Early Termination Request.\n</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DDRCRC</name>
              <description>This field indicates whether the CRC word follows an early termination. \n</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_BTDELY</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_BTDELY</displayName>
          <description>I3C HDR_BT Delay Byte counter Register</description>
          <addressOffset>0xF4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000400</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DLYBCNT</name>
              <description>HDR-BT Delay byte count.\nThis field is used by Product during HDR-BT Read transfers either in Controller mode or in Target mode, to receive/transmit that many delay bytes in HDR-BT Data Block.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXTXDAT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXTXDAT</displayName>
          <description>I3C Target Mode Transfer Data Port Register</description>
          <addressOffset>0x130</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTXDAT</name>
              <description>Transmit Data Port for EXTCMD.\nThis port is mapped to the EXTCMD Tx-Data Buffer.The transmit data should always be packed as 4-byte aligned data words and written to the Transmit Data Port register. If the Command length is not aligned to 4-bytes, then the additional bytes are ignored.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXCMDSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXCMDSTS</displayName>
          <description>I3C Target Mode Extended command Register's Transmit Threshold Status</description>
          <addressOffset>0x150</addressOffset>
          <access>read-only</access>
          <resetValue>0x0000001</resetValue>
          <resetMask>0xFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ECMDSTS</name>
              <description>EXTCMD Transmit Threshold Status.\nThis status is set when the number of empty locations in transmit buffer is greater than or equal to threshold value specified by CMD_TX_BUF_THLD field in EXT_TX_EMPTY_RX_RSP_THLD_CTRL register. This interrupt is cleared automatically when number of empty locations in transmit buffer is less than threshold value specified.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXDLEL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXDLEL</displayName>
          <description>I3C Target Mode Transmit Data Buffer Status level Register for EXTCMD</description>
          <addressOffset>0x154</addressOffset>
          <access>read-only</access>
          <resetValue>0x0000010</resetValue>
          <resetMask>0xFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ECMDLVL</name>
              <description>EXTCMD Transmit Buffer Empty Level Value.\nContains the number of empty locations in the EXTCMD transmit Buffer</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXTCMD1</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXTCMD1</displayName>
          <description>I3C Target Mode Extended Command Register Word 1</description>
          <addressOffset>0x164</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTCMD1</name>
              <description>Word-1 of Extended Transmit Command register.\nThis register represents Extended Command Register-0 used to push commands that enables the Target to respond with Data for either Private or Vendor-CCC Read command received from the Controller. \nRefer to sub section 'Extended Transmit Command Data Structure' under 'Data Structure in Target' for more details. This register is applicable only in Target-Mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXTCMD2</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXTCMD2</displayName>
          <description>I3C Target Mode Extended Command Register Word 2</description>
          <addressOffset>0x168</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTCMD2</name>
              <description>Word-2 of Extended Transmit Command register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXTCMD3</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXTCMD3</displayName>
          <description>I3C Target Mode Extended Command Register Word 3</description>
          <addressOffset>0x16C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTCMD3</name>
              <description>Word-3 of Extended Transmit Command register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXTRCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXTRCTL</displayName>
          <description>I3C Target Mode Extended Command Individual Vendor Reset</description>
          <addressOffset>0x1C4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTTRST</name>
              <description>EXTCMD Transmit Software Reset.\nWrite '1' to this bit to exercise EXTCMD Transmit Buffer reset.\nThis bit is cleared automatically once the EXTCMDTransmit Buffer reset is completed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXCMDVAL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXCMDVAL</displayName>
          <description>I3C Target Mode Extended Command Valid Status Register</description>
          <addressOffset>0x1C8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTCVAL</name>
              <description>EXTCMD has finished sending the Command.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXTHLD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXTHLD</displayName>
          <description>I3C Target Mode Extended Transmit and Receive Response Threshold Register</description>
          <addressOffset>0x1CC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSPDATA</name>
              <description>Target Receive Data Threshold Value for initiating Response.\nThis field controls the number of received data bytes after which a response is generated in the Response FIFOThe supported values for RSP_DATA_THLD are:\n000: 16\n001: 32\n010: 64\n011: 128\n100: 252</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>CMDTX</name>
              <description>Extended TX data Buffer Threshold Value.\nThis field controls the number of empty locations (or above) in the Extended Transmit FIFO that trigger the EXT_CMD_TX_THLD_STS interrupt.If the programmed value is greater than the buffer depth, then threshold is set to IC_EXT_TX_BUF_DEPTH. The supported values for EXT_CMD_TX_BUF_THLD are:\n000: 1\n001: 4\n010: 8</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_VIRPOT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_VIRPOT</displayName>
          <description>I3C Target Mode Virtual Target Pointer Register</description>
          <addressOffset>0x1D0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00040500</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VIRTABLE</name>
              <description>Start Address of Virtual Target Address Table.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>VIRTADPH</name>
              <description>Depth of Virtual Target Address Table.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_GRPA0STS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_GRPA0STS</displayName>
          <description>I3C Target Mode Group Address 0 Status Register</description>
          <addressOffset>0x1E0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000F0</resetValue>
          <resetMask>0xFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GRPADDR</name>
              <description>Device Group Address 0.\nThis field is used to store the Group Address assigned by the Active Controller and used in Target mode of operation.The Active Controller assigns this Group Address through SETGRPA CCC. Target mode uses this Address to acknowledge the Write Trasfers along with Dynamic address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>TIRAVLD</name>
              <description>Valid Bit for 'Group Address 0' of 'Virtual Target'\nThis bit is used to indicate whether the Group address mentioned in 'GRP_ADDR' is valid or not for ' Virtual Target'.Target Mode sets this bit to 1 when Active Controller assigns the Group Address mentioned in 'GRPADDR' field to ' Virtual Target' through SETGRPA CCC. The bit will be set to 0 upon receiving RSTGRPA CCC.\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_GRPA1STS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_GRPA1STS</displayName>
          <description>I3C Target Mode Group Address 1 Status Register</description>
          <addressOffset>0x1E4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000F0</resetValue>
          <resetMask>0xFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GRPADDR</name>
              <description>Device Group Address 1.\nThis field is used to store the Group Address assigned by the Active Controller and used in Target mode of operation.The Active Controller assigns this Group Address through SETGRPA CCC. Target mode uses this Address to acknowledge the Write Trasfers along with Dynamic address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>TIRAVLD</name>
              <description>Valid Bit for 'Group Address 0' of 'Virtual Target'\nThis bit is used to indicate whether the Group address mentioned in 'GRP_ADDR' is valid or not for ' Virtual Target'.Target Mode sets this bit to 1 when Active Controller assigns the Group Address mentioned in 'GRPADDR' field to ' Virtual Target' through SETGRPA CCC. The bit will be set to 0 upon receiving RSTGRPA CCC.\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>

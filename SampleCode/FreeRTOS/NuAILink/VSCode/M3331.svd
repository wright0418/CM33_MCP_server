                 <enumeratedValue>
                    <name>0</name>
                    <description>HXT Schmitt Trigger Mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>HXT Schmitt Trigger Mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>

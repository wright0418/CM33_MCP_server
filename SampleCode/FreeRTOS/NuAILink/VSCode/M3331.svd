                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNDFLINTEN</name>
              <description>Underflow Interrupt Enable Bit\nNote: If this bit is enabled, when the UNDFLIF interrupt flag is set to 1, the LLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Underflow interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Underflow interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FENDINTEN</name>
              <description>Frame End Interrupt Enable Bit\nNote: If this bit is enabled, when the FENDIF interrupt flag is set to 1, the LLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Frame end interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Frame end interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSTCINTEN</name>
              <description>Reset Command Interrupt Enable Bit\nNote: If this bit is enabled, when the RSTCIF interrupt flag is set to 1, the LLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Reset command interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Reset command interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EMPINTEN</name>
              <description>FIFO Empty Interrupt Enable Bit\nNote: If this bit is enabled, when the EMPIF interrupt flag is set to 1, the LLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>FIFO empty interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>FIFO empty interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FULINTEN</name>
              <description>FIFO Full Interrupt Enable Bit\nNote: If this bit is enabled, when the FULIF interrupt flag is set to 1, the LLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>FIFO full interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>FIFO full interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTHIEN</name>
              <description>Transmit FIFO Threshold Interrupt Enable Bit\nNote: This bit is only supported in software mode.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>TX FIFO threshold interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>TX FIFO threshold interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LLSIMODE</name>
              <description>LLSI Mode Select\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Software mode</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PDMA mode</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OFDEF</name>
              <description>Output Format Define\n</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Output RGB format</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Output GRB format</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTH</name>
              <description>Transmit FIFO Threshold\nIf the valid data count of the transmit FIFO buffer is less than or equal to the TXTH setting, the TXTHIF bit will be set to 1, else the TXTHIF bit will be cleared to 0.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_RSTPERIOD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_RSTPERIOD</displayName>
          <description>LLSI Reset Period Control Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSTPERIOD</name>
              <description>Reset Command Period\nThis field is used to adjust the time of reset command.\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_PERIOD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_PERIOD</displayName>
          <description>LLSI Period Control Register</description>
          <addressOffset>0x8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PERIOD</name>
              <description>LLSI Period Register\nThis field is used to define data transfer time (TH+TL).\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_DUTY</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_DUTY</displayName>
          <description>LLSI Duty Control Register</description>
          <addressOffset>0xC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>T0H</name>
              <description>T0H Data Register\nThis field is used to define the time of T0H.\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>T1H</name>
              <description>T1H Data Register\nThis field is used to define the time of T1H.\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_DATA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_DATA</displayName>
          <description>LLSI Data Register</description>
          <addressOffset>0x10</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA</name>
              <description>Data Transmit Register \nThe data transmit registers pass through the transmitted data into the 4-level transmit FIFO buffers.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_PCNT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_PCNT</displayName>
          <description>LLSI Pixel Count Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PCNT</name>
              <description>Pixel Count Register\nUser should write a frame size to this register before transfer.\nFor example, if there are a total of 5 LED (5 pixels) in frame, user should write 5 to this control register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_CLKDIV</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_CLKDIV</displayName>
          <description>LLSI Clock Divider Register</description>
          <addressOffset>0x18</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DIVIDER</name>
              <description>LLSI Clock Divider\nIt indicates the LLSI clock,</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_STATUS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_STATUS</displayName>
          <description>LLSI Status Register</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSTCIF</name>
              <description>Reset Command Interrupt Flag\nThis bit indicates that LLSI has finished reset command transmission.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EMPIF</name>
              <description>FIFO Empty Interrupt Flag\n</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Transmit FIFO buffer is not empty</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Transmit FIFO buffer is empty</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FULIF</name>
              <description>FIFO Full Interrupt Flag\n</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Transmit FIFO buffer is not full</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Transmit FIFO buffer is full</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTHIF</name>
              <description>Transmit FIFO Threshold Interrupt Flag\n</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The valid data count within the transmit FIFO buffer is larger than the setting value of TXTH</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The valid data count within the transmit FIFO buffer is less than or equal to the setting value of TXTH</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNDFLIF</name>
              <description>Under Flow Interrupt Flag\nEach transmission LLSI reads 3 bytes data from the FIFO. This bit is set to 1 when LLSI reads the FIFO and the valid data in FIFO is less than 3 bytes.\nSoftware can write 1 to clear this bit.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FENDIF</name>
              <description>Frame End Interrupt Flag\nThis bit indicates that LLSI has finished data transmission (FIFO empty &amp; shift register empty). When LLSI transfer finish (FIFO empty &amp; shift register empty) this bit is set to 1.\nUser can use this flag to prepare data in advance.\nSoftware can write 1 to clear this bit.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LDT</name>
              <description>Last Data Transmit\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_OCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_OCTL</displayName>
          <description>LLSI Output Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IDOS</name>
              <description>Idle Output Control\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Idle will output 0</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Idle will output 1</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>BTF</name>
      <description>SCU Register Map</description>
      <groupName>SCU</groupName>
      <baseAddress>0x4002F800</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>BTF</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>BTF</displayName>
          <description>Booting Flag Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BL2</name>
              <description>BL2 Flag\nIndicating the CPU is running at BL2</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DPMPTL</name>
      <description>SCU Register Map</description>
      <groupName>SCU</groupName>
      <baseAddress>0xF0001600</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0xF0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFC</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>DPM_MISCEXT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_MISCEXT</displayName>
          <description>DPM Miscellaneous Register for External Debugger</description>
          <addressOffset>0xF0</addressOffset>
          <access>read-write</access>
          <resetValue>0xA5000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PLMOEM</name>
              <description>PLM OEM Stage Flag (Read Only)\nThis bit has the same function as the bit[0] in PLM_STS register</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PLMDEP</name>
              <description>PLM Deployed Stage Flag (Read Only)\nThis bit has the same function as the bit[1] in PLM_STS register</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PLMRMA</name>
              <description>PLM RMA Stage Flag\nThis bit is writable only for external debugger.\nOnly external debugger can set this bit to make PLM from Deployed stage to RMA stage after the external debugger is authenticated (by password).\nWhen read, \nThis bit has the same function as the bit[2] in PLM_STS register</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PLMUPD</name>
              <description>PLM Updated Flag (Read Only)\nThis bit has the same function as the Dirty bit in PLM_STS register</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XOMEXE</name>
              <description>CPU Is Executing XOM (Read Only)\nThis bit indicating CPU is executing XOM, and no debug access is allowed.\nNote: The accessibility of this bit is controlled by DPM_CTL.DACCDIS.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SBS</name>
              <description>Secure Boot Status (Read Only)\nThese bits indicate the value of SBS in DPM_MISC register.\nNote: The accessibility of this bit is controlled by DPM_CTL.DACCDIS.\nError code are listed below:\n#define NUBL_ERR_RMA_STAGE	(0xE0)\n#define NUBL_ERR_MARKER	(0xE1)\n#define NUBL_ERR_FWINFO	(0xE2)\n#define NUBL_ERR_FWHASH	(0xE4)\n#define NUBL_ERR_SYS_INIT	(0xC0)\n#define NUBL_ERR_HARDFAULT	(0xC1)\n#define NUBL_ERR_FNSADDR	(0xC2)\n#define NUBL_ERR_SHA_DMA	(0xC3)\n#define NUBL_ERR_PLM	(0xC4)\n#define NUBL_ERR_READ_DPM	(0xC5)\n#define NUBL_ERR_VECMAP	(0xC6)\n#define NUBL_ERR_ISP NUBL_ERR_NUBL2	(0xC7)\n#define NUBL_ERR_ECC_EXEC	(0xC8)\n#define NUBL_ERR_INVALID_FLOW	(0xC9)\n#define NUBL_ERR_RSVD0	(0xCA)\n#define NUBL_ERR_SET_PL	(0xCB)\n#define NUBL_ERR_CRTPYO	(0xCC)\n#define NUBL_ERR_KS	(0xCD)\n#define NUBL_ERR_DEINIT	(0xCE)\n#define NUBL_ERR_CRC32	(0xCF)\n#define BS_DIRECT_BOOT	(0xB0)  // &#27794;&#26377;&#36305;secure boot&#27969;&#31243;\n#define BS_SECURE_BOOT	(0xB1) // &#36305;secure boot&#27969;&#31243;\n#define BS_RMA_BOOT	(0xB2) // &#36305;secure boot&#27969;&#31243;in RMA stage for FT and module code\n#define BS_INVALID_CODE	(0xB3) // &#20986;&#24288;&#27794;&#26377;code; &#35201;&#22519;&#34892;&#30340;code RO &#21644;RW&#33853;&#22312;&#28961;&#25928;&#30340;&#21312;&#22495;.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RWVCODE</name>
              <description>Write Verify Code and Read Verify Code\nWhen write,\nthe WVCODE is 0x5A.\nWhen read,\nThe RVCODE is 0xA5.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_IDEXT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_IDEXT</displayName>
          <description>DPM Identification Register for External Debugger</description>
          <addressOffset>0xFC</addressOffset>
          <access>read-only</access>
          <resetValue>0x4449551F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Checksum</name>
              <description>Checksum\nChecksum value of ID and Version\nThe value is 0xF. (Sum of all nibbles)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>Version</name>
              <description>DPM Version\nThe value is 0x0</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>ID</name>
              <description>DPM ID\nThe value is ASCII Code "DIU"</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DPM</name>
      <description>SCU Register Map</description>
      <groupName>SCU</groupName>
      <baseAddress>0x4002F600</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0xF0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xFC</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>DPM_MISC</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_MISC</displayName>
          <description>DPM Miscellaneous Register</description>
          <addressOffset>0xF0</addressOffset>
          <access>read-write</access>
          <resetValue>0xA5000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SBS</name>
              <description>Secure Boot Status\nRegister for secure code to set boot status.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RWVCODE</name>
              <description>Write Verify Code and Read Verify Code\nWhen write,\nthe WVCODE is 0x5A.\nWhen read,\nThe RVCODE is 0xA5.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>DPM_ID</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>DPM_ID</displayName>
          <description>DPM Identification Register</description>
          <addressOffset>0xFC</addressOffset>
          <access>read-only</access>
          <resetValue>0x4449551F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Checksum</name>
              <description>Checksum\nChecksum value of ID and Version\nThe value is 0x0. (Sum of all nibbles)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>Version</name>
              <description>DPM Version\nThe value is 0x0</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>ID</name>
              <description>DPM ID\nThe value is 0x444955</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCU</name>
      <description>SCU Register Map</description>
      <groupName>SCU</groupName>
      <baseAddress>0x4002F000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x20</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x2C</offset>
        <size>0xC</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x40</offset>
        <size>0x98</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xF0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x134</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>

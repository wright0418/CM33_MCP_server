          <name>SYS_HXTTCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_HXTTCTL</displayName>
          <description>HXT Test Mode Control Register</description>
          <addressOffset>0x190</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000090</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VL</name>
              <description>Schmitt trigger low level setting (Write Protect)\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>VH</name>
              <description>Schmitt trigger high level setting (Write Protect)\n</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>HY</name>
              <description>GM type comparator hysteresis (Write Protect)\n</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>RFSEL</name>
              <description>Select feedback resistor (Write Protect)\nDefault setting: 10 (200k ohm)</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>IC</name>
              <description>GM type coarse-tune current control (Write Protect)</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>DBGNSEL</name>

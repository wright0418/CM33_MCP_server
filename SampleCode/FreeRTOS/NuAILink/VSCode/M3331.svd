       <register>
          <name>SYS_PMBGCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_PMBGCTL</displayName>
          <description>MEGPM MEGBIAS Control Register</description>
          <addressOffset>0x180</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000810</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VBG_TRIM</name>
              <description>Band-gap reference voltage trimming\nTBD\nDefault value is 10000\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.\nNote: After chip power-on, this bit is defined by ROMMAP24[20:16]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>MBIASTE</name>
              <description>MEGBIAS Test Mode Enable Bit\nWhen MEGBIAS analog macro test mode enable, the switch control output signal is controlled by GPC.11\n</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>MEGBIAS test mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>MEGBIAS test mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SEL_IBG</name>
              <description>MEGPM SEL_IBG Control (Write Protect)\nMEGPM Referernce voltage generation\nNote: Thes bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>scale-up after temperature compensation ,</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>scale-up before temperature compensation (as TC8260)</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CTAT_TRIM</name>
              <description>CTAT trim bits of current gen circuit \nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>8</name>
                    <description>Default</description>
                    <value>#1000</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IGEN_DIS</name>
              <description>MEGPM Current Gen. Disable Control (Write Protect)\nUser can disable MEGPM Current Gen. function writing 0x5A5 to this field.\nNote: Thes bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>F_BUFOLDO</name>
              <description>Force BUFOLDO Enable Bit\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>BUFOLDO Not keep enable (Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BUFOLDO Keep enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F_BUFOSC48</name>
              <description>Force BUFOSC48 Enable Bit\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>BUFOSC48 Not keep enable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BUFOSC48 Keep enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F_BUFVREF</name>
              <description>Force BUFVREF Enable Bit\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>BUFVREF Not keep enable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BUFVREF Keep enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F_BUFADC</name>
              <description>Force BUFADC Enable Bit\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>BUFADC Not keep enable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BUFADC Keep enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F_BUFTRNG</name>
              <description>Force BUFTRNG Enable Bit\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>BUFTRNG Not keep enable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BUFTRNG Keep enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F_BUFFLASH</name>
              <description>Force BUFFLASH Enable Bit\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>BUFFLASH Not keep enable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BUFFLASH Keep enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F_CMP25N</name>
              <description>Force CMP25N current source Disabled Bit\nACMP 25nA reference current disable control.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>

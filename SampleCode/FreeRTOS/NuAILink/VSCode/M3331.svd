              <description>Enable PWMx_BRAKEy Pin As Edge-detect Brake Source (Write Protect)\nNote: This bit is write protected. Refer to&#160;SYS_REGLCTL register.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>

       </register>
       <register>
          <name>SYS_SRAM_PARITY</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_SRAM_PARITY</displayName>
          <description>System SRAM Parity Test Control Register (Only for Testing)</description>
          <addressOffset>0xD8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PTESTEN</name>
              <description>SRAM Parity Test Mode Enable Bit (Write Protect)\nNote: This bit is write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>SRAM parity test mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>SRAM parity test mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PTESTPB</name>
              <description>SRAM Test Mode Parity Bit (Write Protect)\nWhen SRAM test mode is disabled, the parity bit is calculated by even parity generate circuit for each SRAM write action.\nWhen SRAM test mode is enabled, the parity bit is replace by TEST_PB for each SRAM write action. The four bit TEST_PB are corresponding mapping to the four byte in a word.\nNote: This bit is write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_HIRCTCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_HIRCTCTL</displayName>
          <description>HIRC48M Trim Control Register</description>
          <addressOffset>0xE4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00080000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FREQSEL</name>
              <description>Trim Frequency Selection\nThis field indicates the target frequency of 48 MHz internal high speed RC oscillator (HIRC48M) auto trim.\nDuring auto trim operation, if clock error detected with CESTOPEN is set to 1 or trim retry limitation count reached, this field will be cleared to 00 automatically.\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Disable HIRC auto trim function</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Enable HIRC auto trim function and trim HIRC to 48 MHz</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Reserved</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Reserved</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOOPSEL</name>
              <description>Trim Calculation Loop Selection\nThis field defines that trim value calculation is based on how many reference clocks.\nNote: For example, if LOOPSEL is set as 00, auto trim circuit will calculate trim value based on the average frequency difference in 4 clocks of reference clock.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Trim value calculation is based on average difference in 4 clocks of reference clock</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Trim value calculation is based on average difference in 8 clocks of reference clock</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Trim value calculation is based on average difference in 16 clocks of reference clock</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Trim value calculation is based on average difference in 32 clocks of reference clock</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RETRYCNT</name>
              <description>Trim Value Update Limitation Count\nThis field defines that how many times the auto trim circuit will try to update the HIRC trim value before the frequency of HIRC locked.\nOnce the HIRC locked, the internal trim value update counter will be reset.\nIf the trim value update counter reached this limitation value and frequency of HIRC still doesn't lock, the auto trim operation will be disabled and FREQSEL will be cleared to 00.\n</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Trim retry count limitation is 64 loops</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Trim retry count limitation is 128 loops</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Trim retry count limitation is 256 loops</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Trim retry count limitation is 512 loops</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CESTOPEN</name>
              <description>Clock Error Stop Enable Bit\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The trim operation is keep going if clock is inaccuracy</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The trim operation is stopped if clock is inaccuracy</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BOUNDEN</name>
              <description>Boundary Enable Bit\nNote: This function is only supported in M48xGC/M48xG8 series.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Boundary function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Boundary function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>REFCKSEL</name>
              <description>Reference Clock Selection\nNote: HIRC trim reference clock is 20 kHz in test mode.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>HIRC trim reference clock is from LXT (32.768 kHz)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>HIRC trim reference clock is from internal USB synchronous mode SOF (Start-Of-Frame)</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IGNORE</name>
              <description>Ignore HIRC Unstable Period Selection\nNote: For the current version of HIRC, its clock frequency will shift when trim bits change from 0 to 1 or 1 to 0. To solve this problem, RC_TRIM ignore the counting clock of unstable HIRC clock period to prevent trim bit Inaccuracies.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Enable function of ignoring the counting cycles in HIRC unstable period</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Disable function of ignoring the counting cycles in HIRC unstable period</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CKSTBDET</name>
              <description>Hardware Clock Stable Detection\nThis functtion is that rc trim can only work when the RC and reference clock are stable, and system is not in Power-down mode\n</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Disable the clock stable detection function</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Enable the clock stable detection function</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BOUNDARY</name>
              <description>Boundary Selection\nFill the boundary range from 0x1 to 0x31, 0x0 is reserved.\nThis field shows the update value range. If the difference between the current trim value and the new update trim value is smaller than BOUNDARY value, then the trim value will be update to RC or it will keep the current trim value.\nNote 1: When the RC clock shift over 0.25% due to temperature condition in lock state, rc_trim circuit will increase or decrease at least 2 to trim value.\nNote 2: Only when the difference of the current frequency count and the target frequency count is smaller than 0.25% in unlock state, rc_trim circuit will increase or decrease 1 to trim value.\nNote: This field is effective only when the BOUNDEN(SYS_HIRCTCTL[9]) is enabled.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_HIRCTIEN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_HIRCTIEN</displayName>
          <description>HIRC48M Trim Interrupt Enable Register</description>
          <addressOffset>0xE8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TFAILIEN</name>
              <description>Trim Failure Interrupt Enable Bit\nThis bit controls if an interrupt will be triggered while HIRC trim value update limitation count reached and HIRC frequency still not locked on target frequency set by FREQSEL(SYS_HIRCTCTL[1:0]).\nIf this bit is high and TFAILIF(SYS_HIRCTISTS[1]) is set during auto trim operation, an interrupt will be triggered to notify that HIRC trim value update limitation count was reached.\n</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Disable TFAILIF(SYS_HIRCTISTS[1]) status to trigger an interrupt to CPU</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Enable TFAILIF(SYS_HIRCTISTS[1]) status to trigger an interrupt to CPU</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLKEIEN</name>
              <description>Clock Error Interrupt Enable Bit\nThis bit controls if CPU would get an interrupt while clock is inaccuracy during auto trim operation.\nIf this bit is set to1, and CLKERRIF(SYS_HIRCTISTS[2]) is set during auto trim operation, an interrupt will be triggered to notify the clock frequency is inaccuracy.\n</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Disable CLKERRIF(SYS_HIRCTISTS[2]) status to trigger an interrupt to CPU</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Enable CLKERRIF(SYS_HIRCTISTS[2]) status to trigger an interrupt to CPU</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_HIRCTISTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_HIRCTISTS</displayName>
          <description>HIRC48M Trim Interrupt Status Register</description>
          <addressOffset>0xEC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FREQLOCK</name>
              <description>HIRC Frequency Lock Status\nThis bit indicates the HIRC frequency is locked.\nThis is a status bit and doesn't trigger any interrupt.\nWrite 1 to clear this to 0. This bit will be set automatically, if the frequency is lock and the RC_TRIM is enabled.\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The internal high-speed oscillator frequency doesn't lock at 48 MHz yet</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The internal high-speed oscillator frequency locked at 48 MHz</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TFAILIF</name>
              <description>Trim Failure Interrupt Status\nThis bit indicates that HIRC trim value update limitation count reached and the HIRC clock frequency still doesn't be locked. Once this bit is set, the auto trim operation stopped and FREQSEL(SYS_HIRCTCTL[1:0]) will be cleared to 00 by hardware automatically.\nIf this bit is set and TFAILIEN(SYS_HIRCTIEN[1]) is high, an interrupt will be triggered to notify that HIRC trim value update limitation count was reached. Write 1 to clear this to 0.\n</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Trim value update limitation count does not reach</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Trim value update limitation count reached and HIRC frequency still not locked</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLKERRIF</name>
              <description>Clock Error Interrupt Status\nWhen the frequency of 32.768 kHz external low speed crystal oscillator (LXT) or 48 MHz internal high speed RC oscillator (HIRC48M) is shift larger to unreasonable value, this bit will be set and to be an indicate that clock frequency is inaccuracy.\nOnce this bit is set to 1, the auto trim operation stopped and FREQSEL(SYS_HIRCTCTL[1:0]) will be cleared to 00 by hardware automatically if CESTOPEN(SYS_HIRCTCTL[8]) is set to 1.\nIf this bit is set and CLKEIEN(SYS_HIRCTIEN[2]) is high, an interrupt will be triggered to notify the clock frequency is inaccuracy. Write 1 to clear this to 0.\n</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Clock frequency is accuracy</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Clock frequency is inaccuracy</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OVBDIF</name>
              <description>Over Boundary Status\nWhen the over boundary function is set, if there occurs the over boundary condition, this flag will be set.\nNote: Write 1 to clear this flag.\nNote 2: This function is only supported in M48xGC/M48xG8.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Over boundary condition did not occur</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Over boundary condition occurred</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_REGLCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_REGLCTL</displayName>
          <description>Register Lock Control Register</description>
          <addressOffset>0x100</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>REGLCTL</name>
              <description>Register Lock Control Code (Write Only)\nSome registers have write-protection function. Writing these registers have to disable the protected function by writing the sequence value "59h", "16h", "88h" to this field. After this sequence is completed, the REGLCTL bit will be set to 1 and write-protection registers can be normal write.\n\nREGLCTL[0]\nRegister Lock Control Disable Index (Read Only)\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Write-protection Enabled for writing protected registers. Any write to the protected register is ignored</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Write-protection Disabled for writing protected registers</description>
                    <value>1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_RCADJ48M</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_RCADJ48M</displayName>
          <description>HIRC 48M Trim Value Register</description>
          <addressOffset>0x10C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFF000</resetMask>
          <fields>
            <field>
              <name>RCADJ</name>
              <description>RC48M Trim Value (Write Protect)\nThis bit is the protected bit, which means programming it needs to write "59h", "16h", "88h" to address 0x4000_0100 to disable register protection. Refer to the register SYS_REGLCTL at address SYS_BA+0x100.\nThis field reflects the RC48M trim value.\nSoftware can update RC48m trim value by writing this field.\nNote: This bit is write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_RCADJ</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_RCADJ</displayName>
          <description>HIRC Trim Value Register</description>
          <addressOffset>0x110</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFF000</resetMask>
          <fields>
          </fields>
       </register>
       <register>
          <name>SYS_TSOFFSET</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_TSOFFSET</displayName>
          <description>Temperature Sensor Offset Register</description>
          <addressOffset>0x114</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFF000</resetMask>
          <fields>
            <field>
              <name>VTEMP</name>
              <description>Temperature Sensor Offset Value\nThis field reflects temperature sensor output voltage offset at 25oC.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_VREFTRIM</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_VREFTRIM</displayName>
          <description>VREF Trim Value Register</description>
          <addressOffset>0x118</addressOffset>
          <access>read-write</access>
          <resetValue>0x40404040</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VREF1P6TRIM</name>
              <description>VREF 1.6v Trim Value (Write Protect)\nThis bit is the protected bit, which means programming it needs to write "59h", "16h", "88h" to address 0x4000_0100 to disable register protection. Refer to the register SYS_REGLCTL at address SYS_BA+0x100.\nThis field reflects the VREF trim value for VREF select 1.6v output.\nSoftware can update VREF trim value by writing this field for select 1.6v output.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>VREF2P0TRIM</name>
              <description>VREF 2.0v Trim Value (Write Protect)\nThis bit is the protected bit, which means programming it needs to write "59h", "16h", "88h" to address 0x4000_0100 to disable register protection. Refer to the register SYS_REGLCTL at address SYS_BA+0x100.\nThis field reflects the VREF trim value for VREF select 2.0v output.\nSoftware can update VREF trim value by writing this field for select 2.0v output.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>VREF2P5TRIM</name>
              <description>VREF 2.5v Trim Value (Write Protect)\nThis bit is the protected bit, which means programming it needs to write "59h", "16h", "88h" to address 0x4000_0100 to disable register protection. Refer to the register SYS_REGLCTL at address SYS_BA+0x100.\nThis field reflects the VREF trim value for VREF select 2.5v output.\nSoftware can update VREF trim value by writing this field for select 2.5v output.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>VREF3P0TRIM</name>
              <description>VREF 3.0v Trim Value (Write Protect)\nThis bit is the protected bit, which means programming it needs to write "59h", "16h", "88h" to address 0x4000_0100 to disable register protection. Refer to the register SYS_REGLCTL at address SYS_BA+0x100.\nThis field reflects the VREF trim value for VREF select 3.0v output.\nSoftware can update VREF trim value by writing this field for select 3.0v output.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_LVDRCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_LVDRCTL</displayName>
          <description>LVDR Control Register</description>
          <addressOffset>0x11C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF0000</resetMask>
          <fields>
            <field>
              <name>VBULVDRTRIM</name>
              <description>VBU for LVDR and HIRC48M Trim Code Value (Write Protect)\nVBG_LVDR trim, 10mV/step, ACT_LVR &amp; LVD can set different trim value. (for internal use only) \nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_LDOTRIM</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_LDOTRIM</displayName>
          <description>LDO Trim Code Register</description>
          <addressOffset>0x120</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFF00</resetMask>
          <fields>
            <field>
              <name>LDOTRIM</name>
              <description>LDO Trim Code Value (Write Protect)\nThis field reflects factory LDO trim code. (for internal use only) \nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_LDOLVT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_LDOLVT</displayName>
          <description>Main LDO Low Voltage Trim Code Register</description>
          <addressOffset>0x130</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFF00</resetMask>
          <fields>
            <field>
              <name>LDOLVTRIM</name>
              <description>Main LDO Low Voltage Trim Code Value (Write Protect)\nThis field reflects factory LDO low voltage trim code. (for internal use only)\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_LDOHVT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_LDOHVT</displayName>
          <description>Main LDO High Voltage Trim Code Register</description>
          <addressOffset>0x134</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFF00</resetMask>
          <fields>
            <field>
              <name>LDOHVTRIM</name>
              <description>Main LDO High Voltage Trim Code Value (Write Protect)\nThis field reflects factory LDO high voltage trim code. (for internal use only)\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_LIRCT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_LIRCT</displayName>
          <description>Low Speed Internal Oscillator Trim Code Register</description>
          <addressOffset>0x138</addressOffset>
          <access>read-write</access>
          <resetValue>0x00030000</resetValue>
          <resetMask>0xFFFFFF00</resetMask>
          <fields>
            <field>
              <name>LIRCTRIM</name>
              <description>Low Speed Internal Oscillator Trim Code Value (Write Protect)\nThis field reflects factory low speed internal oscillator adjust code. (for internal use only) \nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
            <field>
              <name>LIRCTTRIM</name>
              <description>Low Speed Internal Oscillator Temperature Trim Code Value\nLIRC temperature trim\nDefult is 2b11</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_PMOSCCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_PMOSCCTL</displayName>
          <description>MEGPM OSC Control Register</description>
          <addressOffset>0x13C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFF000</resetMask>
          <fields>
            <field>
              <name>OSC1MTRIM</name>
              <description>OSC1M Trim Code (Write Protect)\nThis field reflects factory low speed internal oscillator adjust code. (for internal use only)\nNote: This field only reset by POR reset.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>268</name>
                    <description>default</description>
                    <value>0x10c</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OSC1MRA</name>
              <description>OSC1M Current options (Write Protect)\nNote: This field only reset by POR reset.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>default</description>
                    <value>#00</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VUPSLOW</name>
              <description>Voltage rising up with more counter wait time (Write Protect)\n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Counter for wait voltage rising is default value</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Counter for wait voltage rising is 130% of default value</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F_OSC1M_EN</name>
              <description>Force OSC1M enable (Write Protect)\nNote: This field only reset by POR reset.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>OSC1M not keep enable.(.default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>OSC1M keep enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_O48MC</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_O48MC</displayName>
          <description>OSC48M Control Register</description>
          <addressOffset>0x140</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xF000F000</resetMask>
          <fields>
            <field>
              <name>ICOMTC</name>
              <description>OSC48M Comparator current trim (Write Protect)\nThis bit field is used to control compartator current for OSC48M\nDefault value is 1000\nNote: After chip power-on, this bit is defined by ROMMAP25[15:12]</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PTC</name>
              <description>OSC48M Postive Tc Adjust (Write Protect)\nThis bit field is used to control positive tc for OSC48M frequency adjusting\nDefault value is 111\nNote: After chip power-on, this bit is defined by ROMMAP25[2:0]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>NTC</name>
              <description>OSC48M Nagtive Tc Adjust (Write Protect)\nThis bit field is used to control negaitive tc for OSC48M frequency adjusting\nDefault value is 111\nNote: After chip power-on, this bit is defined by ROMMAP25[6:4]</description>
              <bitOffset>20</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>OLDOTRIM</name>
              <description>OSC48M LDO Trim Value (Write Protect)\nThis bit field is used to adjust OSC48M LDO voltage\nDefault value is 100\nNote: After chip power-on, this bit is defined by ROMMAP25[26:24]</description>
              <bitOffset>24</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>OSCTESTEN</name>
              <description>OSC48M TEST Enable (Write Protect)\n</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>OSC48M TEST Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>OSC48M TEST Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IOTESTEN</name>
              <description>OSC48M I/O Test Enable Bit (Write Protect)\nNote: This pin do not test ESD</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>OSC48M_OUT_I/O is keep low</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>OSC48M_OUT_I/O toggle (For alpha test jitter measurement)</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_O48BKC</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_O48BKC</displayName>
          <description>OSC48M Backup Control Register</description>
          <addressOffset>0x144</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xF000F000</resetMask>
          <fields>
          </fields>
       </register>
       <register>
          <name>SYS_PMLDOCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_PMLDOCTL</displayName>
          <description>MEGPM LDO Control Register</description>
          <addressOffset>0x168</addressOffset>
          <access>read-write</access>
          <resetValue>0x00010015</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LDO_CS</name>
              <description>LDO bias current option, \nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>25nA</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>50nA(Default)</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>75nA</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>100nA</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LDO_DRVCS</name>
              <description>LDO pass-gate driving ability selection\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>low-driving ability</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>high-driving ability(Default)</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LDOLP_CS</name>
              <description>LDO low-power mode bias current option, \nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>X2</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>X4(Default)</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>X6</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>X8</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LDOTEST_EN</name>
              <description>LDO test mode output enable\nTBD\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LPSIM_SEL</name>
              <description>LDO low-power mode current limit selection\nTBD\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>LDO_PFBEN</name>
              <description>LDO postive feed-back enable\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>disable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LDO_HGAIN</name>
              <description>LDO's OTA gain control\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>low-gain(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>high gain</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LDO_UGB</name>
              <description>LDO unity-gain buffer mode control\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>unity-gain buffer mode disable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>unity-gain buffer mode enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LDO_OPSC</name>
              <description>LDO OTA current option\nTBD\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LVDR_2TPD</name>
              <description>2T-LVR disable\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>enable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>disable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>S_LDOEN</name>
              <description>LDO enable\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>S_LDOLPEN</name>
              <description>LDO low-power mode enable\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LDOSET_BYPASS</name>
              <description>LDO Operation Mode Bypass\nBypass LDO Operation Mode to LDO macro for the following control (Control LDO Directly) \nS_LDOLPEN(SYS_PMLDOCTL[17])\nS_LDOEN(SYS_PMLDOCTL[16])\nLDOTRIM(SYS_LDOTRIM[5:0]) \nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BYPASS_LDORDY</name>
              <description>Bypass LDORDY\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>LDO_RDY is form digital compare LDO trim more than PL2</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>BYPASS LDORDY signal. (PLSEL(SYS_PLCTL[1:0])=11 and SR_PLSEL(SYS_PLCTL[14:12])=111 also enable this function) . For set PLKEEP=1 &amp; PLSEL=PL3 and wakeup form DPD/SPD, set BYPASS_LDORDY =1 then change PLSEL to avoid clock stop for a while</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GATE_LP</name>
              <description>Gating LDO low-power mode control\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote: This field only reset by POR reset.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>function diable(default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>enable LP mode gating function</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_SRAMRMC0</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_SRAMRMC0</displayName>
          <description>SRAM Read Margin Control Register 0</description>
          <addressOffset>0x170</addressOffset>
          <access>read-write</access>
          <resetValue>0x83838383</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RM_SRAM</name>
              <description>SYSTEM SRAM Read Margin Value\nWhen system SRAM read margin mode enable, user can set this field to control system SRAM read margin value. Default is 0011 for Synopsys default value.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RMEN_SRAM</name>
              <description>SYSTEM SRAM Read Margin Enable Bit\nWhen system SRAM read margin mode enable, user can set system SRAM read margin value by RM_SRAM[3:0].\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>system SRAM read margin mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>system SRAM read margin mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RM_CACHE</name>
              <description>CACHE SRAM Read Margin Value\nWhen CACHE SRAM read margin mode enable, user can set this field to control CACHE SRAM read margin value. Default is 0011 for Synopsys default value.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RMEN_CACHE</name>
              <description>CACHE SRAM Read Margin Enable Bit\nWhen CACHE SRAM read margin mode enable, user can set CACHE SRAM read margin value by RM[3:0].\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>CACHE SRAM read margin mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CACHE SRAM read margin mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RM_I3C</name>
              <description>I3C SRAM Read Margin Value\nWhen I3C SRAM read margin mode enable, user can set this field to I3C SRAM read margin value. Default is 0011 for Synopsys default value.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RMEN_I3C</name>
              <description>I3C SRAM Read Margin Enable Bit\nWhen I3C SRAM read margin mode enable, user can set system I3C SRAM read margin value by RM[3:0].\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>I3C SRAM read margin mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>I3C SRAM read margin mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RM_MCAN</name>
              <description>MCAN SRAM Read Margin Value\nWhen MCAN SRAM read margin mode enable, user can set this field to control MCAN SRAM read margin value. Default is 0011 for Synopsys default value.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>RMEN_MCAN</name>
              <description>MCAN SRAM Read Margin Enable Bit\nWhen MCAN SRAM read margin mode enable, user can set MCAN SRAM read margin value by RM[3:0].\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>MCAN SRAM read margin mode Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>MCAN SRAM read margin mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>

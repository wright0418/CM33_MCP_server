            <field>
              <name>TEFW</name>
              <description>Tx Event FIFO Watermark Reached\n</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Tx Event FIFO &#64257;ll level below watermark</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Tx Event FIFO &#64257;ll level reached watermark</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>

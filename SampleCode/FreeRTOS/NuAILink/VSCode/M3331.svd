              <name>T0H</name>
              <description>T0H Data Register\nThis field is used to define the time of T0H.\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>T1H</name>
              <description>T1H Data Register\nThis field is used to define the time of T1H.\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_DATA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_DATA</displayName>
          <description>LLSI Data Register</description>
          <addressOffset>0x10</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA</name>
              <description>Data Transmit Register \nThe data transmit registers pass through the transmitted data into the 4-level transmit FIFO buffers.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_PCNT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_PCNT</displayName>
          <description>LLSI Pixel Count Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PCNT</name>
              <description>Pixel Count Register\nUser should write a frame size to this register before transfer.\nFor example, if there are a total of 5 LED (5 pixels) in frame, user should write 5 to this control register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_CLKDIV</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_CLKDIV</displayName>
          <description>LLSI Clock Divider Register</description>
          <addressOffset>0x18</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DIVIDER</name>
              <description>LLSI Clock Divider\nIt indicates the LLSI clock,</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_STATUS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_STATUS</displayName>
          <description>LLSI Status Register</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSTCIF</name>
              <description>Reset Command Interrupt Flag\nThis bit indicates that LLSI has finished reset command transmission.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EMPIF</name>
              <description>FIFO Empty Interrupt Flag\n</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Transmit FIFO buffer is not empty</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Transmit FIFO buffer is empty</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FULIF</name>
              <description>FIFO Full Interrupt Flag\n</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Transmit FIFO buffer is not full</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Transmit FIFO buffer is full</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTHIF</name>
              <description>Transmit FIFO Threshold Interrupt Flag\n</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The valid data count within the transmit FIFO buffer is larger than the setting value of TXTH</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The valid data count within the transmit FIFO buffer is less than or equal to the setting value of TXTH</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNDFLIF</name>
              <description>Under Flow Interrupt Flag\nEach transmission LLSI reads 3 bytes data from the FIFO. This bit is set to 1 when LLSI reads the FIFO and the valid data in FIFO is less than 3 bytes.\nSoftware can write 1 to clear this bit.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FENDIF</name>
              <description>Frame End Interrupt Flag\nThis bit indicates that LLSI has finished data transmission (FIFO empty &amp; shift register empty). When LLSI transfer finish (FIFO empty &amp; shift register empty) this bit is set to 1.\nUser can use this flag to prepare data in advance.\nSoftware can write 1 to clear this bit.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LDT</name>
              <description>Last Data Transmit\n</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>LLSI_OCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LLSI_OCTL</displayName>
          <description>LLSI Output Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IDOS</name>
              <description>Idle Output Control\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Idle will output 0</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Idle will output 1</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>LLSI8_NS</name>
      <description>LLSI Register Map</description>
      <groupName>LLSI</groupName>
      <baseAddress>0x50088800</baseAddress>

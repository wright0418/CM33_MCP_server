                    <name>1</name>
                    <description>Reserved</description>
                    <value>0x01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Reserved</description>
                    <value>0x02</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>M3331g8</description>
                    <value>0x03</value>
                 </enumeratedValue>

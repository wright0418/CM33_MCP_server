       <register>
          <name>SYS_BLOPTION</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_BLOPTION</displayName>
          <description>Boot Loader Option Register</description>
          <addressOffset>0x1C0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xF0FFFFFF</resetMask>
          <fields>
            <field>
              <name>UARTISPEN</name>
              <description>MKROM UART ISP Mode Enable Bit (read only)\n0: UART ISP mode Disabled\n1: UART ISP mode Enabled \nNote: When chip reset, default value comes from CONFIG3[8]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>USBISPDIS</name>
              <description>MKROM USBD ISP Mode Disable Bit (read only)\n0: USBD ISP mode Enabled\n1: USBD ISP mode Disable\nNote: When chip reset, default value comes from CONFIG3[9]</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CANISPEN</name>
              <description>MKROM CAN ISP Mode Enable Bit (read only)\n0: CAN ISP mode Disabled\n1: CAN ISP mode Enabled\nNote: When chip reset, default value comes from CONFIG3[10]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2CISPEN</name>
              <description>MKROM I2C ISP Mode Enable Bit (read only)\n0: I2C ISP mode Disabled\n1: I2C ISP mode Enabled\nNote: When chip reset, default value comes from CONFIG3[11]</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SPIISPEN</name>
              <description>MKROM SPI ISP Mode Enable Bit (read only)\n0: SPI ISP mode Disabled\n1: SPI ISP mode Enabled\nNote: When chip reset, default value comes from CONFIG3[12]</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BLSPEED</name>
              <description>Boot Loader Speed Selection (Write Protect)\nNote: When chip reset, default value comes from ROMMAP0[30:29]</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Boot loader operating speed is 12 MHz</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Boot loader operating speed is 96 MHz</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Boot loader operating speed is 144 MHz</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Boot loader operating speed is 160 MHz</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ROMISPEN</name>
              <description>MKROM ISP Function Enable Bit (read only)\n0: MKROM ISP function Disabled\n1: MKROM ISP function Enabled\nNote: When chip reset, default value comes from ROMMAP0[22]</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_PORDISAN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_PORDISAN</displayName>
          <description>Analog POR Disable Control Register</description>
          <addressOffset>0x1EC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>POROFFAN</name>
              <description>Power-on Reset Enable Bit (Write Protect)\nAfter powered on, User can turn off internal analog POR circuit to save power by writing 0x5AA5 to this field.\nThe analog POR circuit will be active again when this field is set to another value or chip is reset by other reset source, including:\nnRESET, Watchdog, LVR reset, BOD reset, ICE reset command and the software-chip reset function.\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>PORHLSEL</name>
              <description>High Voltage and Low Voltage Power-on Reset Enable Select Bit (Write Protect)\nAfter setting PORFFAN to 0x5AA5, HVPOR and LVPOR will be disabled by default setting, user can enable HVPOR or LVPOR by setting this field. (internal test only)\nNote: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>85</name>
                    <description>LVPOR is on and HVPOR is off</description>
                    <value>0x55</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>170</name>
                    <description>LVPOR is off and HVPOR is on</description>
                    <value>0xaa</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>SYS_ETMCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_ETMCTL</displayName>
          <description>ETM Control Register</description>
          <addressOffset>0x1F0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ETMCKSEL</name>
              <description>ETM Trace Clock Delay Select\n0000: ETM trace clock delay 0 unit time.\n0001: ETM trace clock delay 1 unit time.\n0010: ETM trace clock delay 2 unit time.\n0011: ETM trace clock delay 3 unit time.\n0100: ETM trace clock delay 4 unit time.\n0101: ETM trace clock delay 5 unit time.\n0110: ETM trace clock delay 6 unit time.\n0111: ETM trace clock delay 7 unit time.\n1000: ETM trace clock delay 8 unit time.\n1001: ETM trace clock delay 9 unit time.\n1010: ETM trace clock delay 10 unit time.\nOthers: Reserved.\nNote 1: This bit should be set before enable ETM multi-function.\nNote 2: The delay unit is around 1ns.\nNote 3: These bits are write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>

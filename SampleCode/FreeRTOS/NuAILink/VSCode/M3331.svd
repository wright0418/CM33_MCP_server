          <fields>
            <field>
              <name>ZTE0</name>
              <description>EPWM Zero Point Trigger DAC Enable Bits\nEPWM can trigger DAC to start action when EPWM counter down count to zero if this bit is set to1.\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>

# Ignore build artifacts and temporary files for the Nuvoton BSP project

# Build output directories
/build/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja
compile_commands.json

# Object and binary files
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.elf
*.bin
*.hex
*.map
*.lst

# IDE and editor files
.vscode/
*.code-workspace
.vs/
*.suo
*.user

# Python
__pycache__/
*.pyc

# Temporary and backup files
*~
*.tmp
*.log

# OS files
Thumbs.db
.DS_Store

# NuAILink local generated artifacts (keep scope narrow)
SampleCode/FreeRTOS/NuAILink/VSCode/out/
SampleCode/FreeRTOS/NuAILink/VSCode/tmp/
SampleCode/FreeRTOS/NuAILink/host_tools/.venv/
SampleCode/FreeRTOS/NuAILink/host_tools/com4_probe.py

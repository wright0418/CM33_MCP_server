{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMSIS-DAP@Arm-Debugger (launch)",
            "type": "arm-debugger",
            "request": "launch",
            "connectionAddress": "${command:device-manager.getSerialNumber}",
            "programs": "${command:cmsis-csolution.getBinaryFiles}",
            "cmsisPack": "${command:cmsis-csolution.getDfpName}",
            "deviceName": "${command:cmsis-csolution.getDeviceName}",
            "processorName": "${command:cmsis-csolution.getProcessorName}",
            "workspaceFolder": "${workspaceFolder}/SampleCode\\FreeRTOS\\NuAILink\\VSCode"
        },
        {
            "name": "CMSIS_DAP@pyOCD (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/SampleCode\\FreeRTOS\\NuAILink\\VSCode",
            "program": "out/NuAILink/FreeRTOS/NuAILink.axf",
            "gdb": "arm-none-eabi-gdb",
            "preLaunchTask": "CMSIS Load",
            "initCommands": [
                "monitor reset halt",
                "tbreak main"
            ],
            "customResetCommands": [
                "monitor reset halt"
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "gdbserver",
                    "--port",
                    "undefined",
                    "--probe",
                    "cmsisdap:",
                    "--connect",
                    "attach",
                    "--cbuild-run",
                    "${command:cmsis-csolution.getCbuildRunFile}"
                ],
                "port": "undefined"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        },
        {
            "name": "CMSIS_DAP@pyOCD (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/SampleCode\\FreeRTOS\\NuAILink\\VSCode",
            "program": "out/NuAILink/FreeRTOS/NuAILink.axf",
            "gdb": "arm-none-eabi-gdb",
            "initCommands": [
                ""
            ],
            "customResetCommands": [
                "monitor reset halt"
            ],
            "target": {
                "port": "undefined"
            },
            "cmsis": {
                "updateConfiguration": "auto"
            }
        }
    ]
}